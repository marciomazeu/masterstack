@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ConfirmEmailTitle"];
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0 py-5">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-3">@Localizer["ConfirmSuccessHeader"]</h2>
                    <p class="text-muted mb-4 fs-5">
                        @Localizer["ConfirmSuccessMessage"]
                    </p>

                    <div class="d-grid gap-2 col-8 mx-auto">
                        <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture" 
                           class="btn btn-primary btn-lg fw-bold shadow-sm">
                            @Localizer["GoToHome"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}