@model MasterStack.ViewModels.EnableTwoFactorViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    var currentCulture = ViewData["CurrentCulture"]?.ToString() ?? "pt-BR";
    ViewData["Title"] = Localizer["Enable2FATitle"];
}

<div class="container mt-5">
    <div class="card max-width-600 mx-auto shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            🔒 @Localizer["Enable2FAHeader"]
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <p>@Localizer["Enable2FAStepsTitle"]</p>
            <ol>
                <li>@Localizer["Enable2FAStep1"]</li>
                <li>@Localizer["Enable2FAStep2"]</li>
            </ol>

            <div class="text-center my-4">
                <div id="qrCode" class="d-inline-block p-3 bg-white border rounded"></div>
            </div>

            <div class="alert alert-light border small text-center mb-4">
                <strong>@Localizer["ManualKeyLabel"]:</strong> <br/>
                <code class="text-dark fw-bold">@Model.SharedKey</code>
            </div>

            <form asp-action="EnableTwoFactor" 
                  asp-controller="Account" 
                  asp-route-culture="@currentCulture" 
                  method="post">
            
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="SharedKey" />
                <input type="hidden" asp-for="AuthenticatorUri" />

                <div class="mb-3">
                    <label asp-for="VerificationCode" class="form-label fw-bold">@Localizer["EnterCodeLabel"]</label>
                    <input asp-for="VerificationCode" class="form-control form-control-lg text-center" placeholder="000000" autocomplete="off" required maxlength="6" />
                    <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">@Localizer["VerifyAndSaveButton"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrCode"), {
            text: "@Html.Raw(Model.AuthenticatorUri)",
            width: 200,
            height: 200
        });
    </script>
}