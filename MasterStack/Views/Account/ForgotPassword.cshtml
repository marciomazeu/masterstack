@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"];
    // DEFINA A CULTURA AQUI
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-4 text-center">
                    <h2 class="fw-bold">@Localizer["ForgotPasswordTitle"]</h2>
                    <p class="text-muted">@Localizer["ForgotPasswordInstruction"]</p>
                    
                    <form asp-controller="Account" asp-action="ForgotPassword" asp-route-culture="@culture" method="post">
                        <div class="mb-3 text-start">
                            <label class="form-label">@Localizer["Email"]</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            @Localizer["SendResetLink"]
                        </button>
                    </form>

                    <div class="mt-3">
                        <a asp-action="Login" asp-route-culture="@culture" class="text-decoration-none">
                            @Localizer["BackToLogin"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>