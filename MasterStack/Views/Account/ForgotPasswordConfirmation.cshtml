@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
    ViewData["Title"] = Localizer["CheckEmailTitle"];
}

<div class="container mt-5 text-center">
    <div class="card shadow border-0 p-5">
        <i class="bi bi-envelope-check text-primary" style="font-size: 4rem;"></i>
        <h2 class="fw-bold mt-3">@Localizer["CheckEmailHeading"]</h2>
        <p class="text-muted">@Localizer["CheckEmailMessage"]</p>
        <a asp-controller="Home" asp-action="Index" asp-route-culture="@currentCulture" class="btn btn-outline-primary mt-3">
            @Localizer["BackToHome"]
        </a>
    </div>
</div>