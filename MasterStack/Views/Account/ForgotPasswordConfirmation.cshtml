@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"];
}

<div class="container mt-5 text-center">
    <div class="card shadow border-0 p-5">
        <i class="bi bi-envelope-check text-primary" style="font-size: 4rem;"></i>
        <h2 class="fw-bold mt-3">Verifique seu e-mail</h2>
        <p class="text-muted">Se o e-mail informado estiver cadastrado, você receberá um link para redefinir sua senha em instantes.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3">Voltar para Home</a>
    </div>
</div>