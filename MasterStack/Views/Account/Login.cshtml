@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = null; 
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>@Localizer["LoginTitle"] - MasterStack</title>
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                         <h3 class="fw-bold"><span class="text-primary">MASTER</span>STACK</h3>
                         <p class="text-muted small">@Localizer["LoginSubtitle"]</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        @* Aqui o erro já deve vir traduzido do Controller, mas podemos garantir *@
                        <div class="alert alert-danger small">@ViewBag.Error</div>
                    }
                    <input type="hidden" id="recaptchaToken" name="recaptchaToken" />
                   
                    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">@Localizer["EmailOrUsername"]</label>
                            <input type="text" name="username" class="form-control" required autofocus />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">@Localizer["Password"]</label>
                            <input type="password" name="password" class="form-control" required />
                        </div>

                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">@Localizer["Btn_Login"]</button>
                        
                        <div class="mt-4 text-center small">
                            <p class="mb-0 text-muted">@Localizer["NoAccountYet"]</p>
                            <a asp-controller="Account" asp-action="Register" asp-route-culture="@culture" class="text-decoration-none fw-bold">
                                @Localizer["RegisterHere"]
                            </a>
                        </div>
                        <div class="mb-3">
    <a asp-controller="Account" asp-action="ForgotPassword" asp-route-culture="@culture">
    @Localizer["ForgotPassword"]
</a>
</div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3">
                <a href="/" class="text-muted small text-decoration-none">← @Localizer["BackToSite"]</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>

<script src="https://www.google.com/recaptcha/api.js?render=@Configuration["Recaptcha:SiteKey"]"></script>
<script>
  grecaptcha.ready(function() {
      grecaptcha.execute('@Configuration["Recaptcha:SiteKey"]', {action: 'submit'}).then(function(token) {
          document.getElementById('recaptchaToken').value = token;
      });
  });
</script>