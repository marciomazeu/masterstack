@model MasterStack.ViewModels.LoginWith2FAViewModel
@{
    ViewData["Title"] = "Autenticação em Dois Fatores";
}

<div class="container mt-5">
    <div class="card max-width-450 mx-auto shadow-sm border-0">
        <div class="card-body p-4 text-center">
            <div class="text-primary mb-3">
                <i class="fas fa-shield-alt fa-3x"></i>
            </div>
            <h3 class="fw-bold mb-2">Segurança Máxima</h3>
            <p class="text-muted small">
                Sua conta possui verificação em duas etapas. Abra o aplicativo autenticador (Google Authenticator) no seu celular para obter o código de acesso.
            </p>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <form asp-action="LoginWith2FA" asp-controller="Account" asp-route-culture="@ViewData["CurrentCulture"]" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="text-start mt-4">
                <input type="hidden" name="culture" value="@ViewData["CurrentCulture"]" />
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="TwoFactorCode" class="form-label fw-bold text-muted small text-uppercase">Código de Verificação</label>
                    <input asp-for="TwoFactorCode" class="form-control form-control-lg text-center fw-bold" placeholder="000000" maxlength="6" autocomplete="off" autofocus required />
                    <span asp-validation-for="TwoFactorCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Verificar e Entrar</button>
            </form>
        </div>
    </div>
</div>