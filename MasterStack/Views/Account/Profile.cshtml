@using Microsoft.Extensions.Localization
@model MasterStack.ViewModels.ProfileViewModel
@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = @Localizer["Profile_Bio"];
    // Removida a linha que causava o erro de sintaxe e o NullReference
}

@if (Model == null)
{
    <div class="container mt-5">
        <div class="alert alert-warning shadow-sm">
            <h2>Perfil não encontrado</h2>
            <p>Você ainda não preencheu suas informações de autor.</p>
            <a href="@Url.Action("CreateProfile", "Admin")" class="btn btn-primary">Criar Perfil Agora</a>
        </div>
    </div>
}
else
{
    @* TUDO o que usa o Model deve estar dentro deste bloco ELSE *@
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-4">
                <div class="card shadow-sm text-center p-4">
                    <div class="mb-3">
                        @* Uso seguro do Model aqui dentro *@
                        <img id="profilePreview" src="@(Model.CurrentImageUrl ?? "/img/default-avatar.png")" 
                             class="rounded-circle img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('fileInput').click()">
                        @Localizer["ChangePhoto"]
                    </button>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-bold">@Localizer["PublicInformation"]: @Model.DisplayName</div>
                    <div class="card-body">
                       <form asp-action="UpdateProfile" 
                            asp-route-culture="@ViewContext.RouteData.Values["culture"]" 
                            method="post" 
                            enctype="multipart/form-data">
                            @* SUMÁRIO DE ERROS (Opcional, mas ajuda muito) *@
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                            @Html.AntiForgeryToken()
                            <input type="file" id="fileInput" name="NewImage" class="d-none" onchange="previewImage(this)">
                            <div class="mb-3">
                                <label class="form-label fw-bold">@Localizer["DisplayName"]</label>
                                <input asp-for="DisplayName" class="form-control" placeholder="Como você quer ser chamado?">
                                @* MENSAGEM DE ERRO AQUI *@
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    @* Corrigido aqui: Acessa direto do Model, sem o ".Author" *@
                                    @(Model.IsAuthorOrAdmin ? Localizer["Profile_Bio_PT"] : Localizer["Profile_Bio"])
                                </label>
                                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                            </div>
                            @if (Model.IsAuthorOrAdmin)
                            {
                                <div class="card bg-dark text-light p-3 mb-3 border-secondary">
                                    <h5 class="card-title text-info">
                                        <i class="fas fa-language me-2"></i> @Localizer["Profile_Author_Translations"]
                                    </h5>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">@Localizer["Profile_Bio_EN"]</label>
                                        <textarea asp-for="Bio_EN" class="form-control" rows="3"></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">@Localizer["Profile_Bio_FR"]</label>
                                        <textarea asp-for="Bio_FR" class="form-control" rows="3"></textarea>
                                    </div>
                                </div>
                            }

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="small fw-bold">LinkedIn</label>
                                    <input asp-for="LinkedInUrl" class="form-control form-control-sm">
                                    <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="small fw-bold">Twitter/X</label>
                                    <input asp-for="TwitterUrl" class="form-control form-control-sm">
                                    <span asp-validation-for="TwitterUrl" class="text-danger small"></span>
                                </div>
                                
                                <div class="col-md-4 mb-3">
                                    <label class="small fw-bold">GitHub</label>
                                    <input asp-for="GitHubUrl" class="form-control form-control-sm">
                                    <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary px-4">@Localizer["SaveProfile"]</button>
                        </form>

                        <div class="card mt-4 border-0 shadow-sm">
                        <div class="card-header bg-dark text-white fw-bold">
                            🛡️ Segurança da Conta
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">
                                A autenticação em duas etapas (2FA) adiciona uma camada extra de segurança à sua conta, exigindo um código do seu celular na hora do login.
                            </p>

                            @if (Model.IsTwoFactorEnabled)
                                {
                                    <div class="alert alert-success d-flex align-items-center" role="alert">
                                        <i class="fas fa-check-circle me-2"></i>
                                        <div><strong>Status:</strong> Sua conta está protegida com a Autenticação em Dois Fatores.</div>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="EnableTwoFactor" 
                                    asp-controller="Account" 
                                    asp-route-culture="@CultureInfo.CurrentCulture.Name" 
                                    class="btn btn-primary fw-bold">
                                        <i class="fas fa-shield-alt me-2"></i> Ativar Proteção de 2 Fatores
                                    </a>
                                }
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('profilePreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        // Pegamos o valor do TempData. O Html.Raw é essencial aqui.
        var successMsg = '@Html.Raw(TempData["Success"])';
        
        if (successMsg && successMsg.trim() !== "") {
            Swal.fire({
                icon: 'success',
                title: '@Localizer["SuccessTitle"]',
                text: successMsg,
                timer: 4000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end',
                timerProgressBar: true
            });
        } 
        else if ('@ViewData.ModelState.IsValid' === 'False') {
            Swal.fire({
                icon: 'error',
                title: 'Ops...',
                text: '@Localizer["ErrorFormMessage"]',
                confirmButtonColor: '#3085d6'
            });
        }
    });
</script>