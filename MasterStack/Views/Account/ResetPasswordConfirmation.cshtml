@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MasterStack.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ResetPasswordConfirmationTitle"] ?? "Senha Redefinida";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-3">@Localizer["ResetPasswordConfirmationTitle"]</h2>
                    <p class="text-muted mb-4">
                        @Localizer["ResetPasswordConfirmationMessage"]
                    </p>
                    <a asp-action="Login" asp-controller="Account" 
                       asp-route-culture="@(Context.GetRouteValue("culture"))" 
                       class="btn btn-primary btn-lg w-100">
                        @Localizer["BackToLogin"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>