@model IEnumerable<MasterStack.Models.BlogPost>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using System.Web
@{
    ViewData["Title"] = Localizer["Painel Administrativo"];
    var culture = ViewContext.RouteData.Values["culture"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @* <h1 class="h2"><i class="fas fa-tools me-2 text-secondary"></i>Painel Administrativo</h1> *@
        <h1 class="h2"><i class="fas fa-tools me-2 text-secondary"></i>@Localizer["AdminDashboard"]</h1>
        <a asp-controller="BlogPosts" asp-action="Create" asp-route-culture="@culture" class="btn btn-success shadow-sm">
            <i class="fas fa-plus me-1"></i>@Localizer["NewPost"]
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Localizer["PostId"]</th>
                        <th>@Localizer["Imagem"]</th>
                        <th>@Localizer["Título"]</th>
                        <th>@Localizer["Data"]</th>
                        <th class="text-end">@Localizer["Ações"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var principal = item.Translations.OrderBy(t => t.Id).FirstOrDefault()
                        ?? new MasterStack.Models.BlogPostTranslation { Title = "Sem título" };

                        @foreach (var t in item.Translations)
                        {
                            <tr>
                                <td>@item.Id</td>
                                @* Miniatura da Imagem Real da Tradução *@
                                <td>
                                    @if (!string.IsNullOrEmpty(t.ImageUrl))
                                    {
                                        <img src="@t.ImageUrl" alt="Thumbnail" class="rounded shadow-sm" style="width: 50px; height: 35px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        
                                            <img src="~/uploads/default-post.jpg" alt="Thumbnail" class="rounded shadow-sm" style="width: 50px; height: 35px; object-fit: cover;" />
                                        
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-secondary me-2">@t.Culture.ToUpper()</span>
                                    <strong>@t.Title</strong>
                                </td>

                                <td class="text-muted" style="font-size: 0.85rem;">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-end">
                                    <div class="btn-group shadow-sm">
                                        @* Adicionar Novo Idioma (Só aparece na primeira linha do post para não poluir) *@
                                        @if (t == item.Translations.First())
                                        {
                                            <div class="btn-group" role="group">
                                                <button id="btnGroupDrop1" type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                                <ul class="dropdown-menu shadow border-0" aria-labelledby="btnGroupDrop1">
                                                    <li><h6 class="dropdown-header">@Localizer["AddTranslation"]</h6></li>
                                                    @foreach (var lang in new[] { "pt-BR", "en-US", "fr-CA" })
                                                    {
                                                        @* REGRA: Não permite criar idioma que já existe *@
                                                        if (!item.Translations.Any(trans => trans.Culture == lang))
                                                        {
                                                            <li>
                                                                <a class="dropdown-item"
                                                                   href="/@culture/Admin/AddTranslation/@item.Id?targetCulture=@lang">
                                                                    @lang.ToUpper()
                                                                </a>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        <a asp-controller="BlogPosts" asp-action="EditTranslation" asp-route-id="@t.Id" asp-route-culture="@culture" class="btn btn-sm btn-outline-warning" title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a asp-controller="BlogPosts" asp-action="Details" asp-route-slug="@t.Slug" asp-route-culture="@t.Culture" class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (item.Translations.Count() > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="prepareDelete('@Url.Action("DeleteTranslation", "BlogPosts", new { id = t.Id, culture = culture })', '@Html.Raw(HttpUtility.JavaScriptStringEncode(t.Title))', false)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }

                                        @if (t == item.Translations.First())
                                        {
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    onclick="prepareDelete('@Url.Action("DeletePost", "BlogPosts", new { id = item.Id, culture = culture })', '@Html.Raw(HttpUtility.JavaScriptStringEncode(principal.Title))', true)"
                                                    title="@Localizer["Excluir Post Completo"]">
                                                <i class="fas fa-bomb"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @* Linha de separação visual entre posts *@
                        <tr class="table-light"><td colspan="4" style="height: 4px; padding: 0;"></td></tr>
                    }
                </tbody>
               
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>@Localizer["ConfirmarExclusao"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p id="deleteActionText" class="mb-0">@Localizer["Tem certeza que deseja apagar:"]</p>
                <h5 id="postTitleToDelete" class="mt-2 fw-bold text-dark"></h5>

                <div id="fullDeleteWarning" class="alert alert-danger mt-3 d-none">
                    <i class="fas fa-bomb me-2"></i>
                    <strong>@Localizer["Atenção:"]</strong> @Localizer["Isso removerá TODOS os idiomas deste post!"]
                </div>

                <small class="text-muted d-block mt-3">@Localizer["AcaoIrreversivel"]</small>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancelar"]</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">@Localizer["SimApagar"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function prepareDelete(url, title, isFullPost) {
        // Injeta o título
        document.getElementById('postTitleToDelete').innerText = title;

        // Define a URL de destino
        document.getElementById('deleteForm').action = url;

        // Altera o texto e o alerta se for exclusão total
        const warning = document.getElementById('fullDeleteWarning');
        const actionText = document.getElementById('deleteActionText');

        if (isFullPost) {
            warning.classList.remove('d-none');
            actionText.innerText = "@Localizer["Você está prestes a excluir o POST COMPLETO:"]";
        } else {
            warning.classList.add('d-none');
            actionText.innerText = "@Localizer["Tem certeza que deseja apagar a tradução:"]";
        }

        var myModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        myModal.show();
    }
</script>