@model IEnumerable<MasterStack.ViewModels.UserListViewModel>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["UserManagement"];
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<div class="container py-5">
    @* Cabeçalho e Ações *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0"><i class="fas fa-users me-2 text-primary"></i>@Localizer["UserManagement"]</h1>
            <p class="text-muted small">@Localizer["UserManagementMessage"]</p>
        </div>
    </div>

    @* Barra de Filtros e Pesquisa *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="@Localizer["EmailOrName"]">
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">@Localizer["Status"]</option>
            <option value="active">@Localizer["Active"]</option>
            <option value="locked">@Localizer["Locked"]</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="roleFilter" class="form-select">
            <option value="">@Localizer["Roles"]</option>
            @foreach (var role in ViewBag.AllRoles) {
                <option value="@role">@role</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100">@Localizer["Filter"]</button>
    </div>
</form>
        </div>
    </div>

    @* Tabela de Utilizadores *@
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@Localizer["UsersRegistered"]</th>
                        <th>@Localizer["Roles"]</th>
                        <th>Status</th>
                        <th class="text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-placeholder me-3 bg-soft-primary text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        @user.DisplayName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold">@user.DisplayName</div>
                                        <div class="text-muted small">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-outline-primary border text-primary rounded-pill px-3 me-1 small">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="fas fa-ban me-1"></i> Bloqueado</span>
                                }
                                else if (!user.IsEmailConfirmed)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-envelope me-1"></i> Pendente</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i> Ativo</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group border rounded shadow-sm bg-white">
                                    <a asp-controller="Admin" 
   asp-action="EditUser" 
   asp-route-culture="@(ViewContext.RouteData.Values["culture"] ?? "pt-BR")" 
   asp-route-id="@user.Id" 
   class="btn btn-sm btn-primary">
                                       
                                        <i class="bi bi-pencil-square"></i> <span class="d-none d-md-inline">@Localizer["Edit"]</span>
                                    </a>
                                    
                                    <form asp-action="ToggleLock" asp-route-culture="@culture" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-light border-0" 
                                                title="@(user.IsLockedOut ? "Desbloquear" : "Bloquear")">
                                            <i class="fas @(user.IsLockedOut ? "fa-unlock text-success" : "fa-user-lock text-danger")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Paginação Dinâmica *@
        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaAtual ? "active" : "")">
                                <a class="page-link" asp-action="Users" asp-route-culture="@culture" 
                                   asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .bg-soft-primary { background-color: #e7f1ff; }
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .avatar-placeholder { font-size: 1.1rem; border: 1px solid #dee2e6; }
    .badge { font-weight: 500; }
</style>

