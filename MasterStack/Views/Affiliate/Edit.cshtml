@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model MasterStack.Models.AffiliateProduct

@{
    ViewData["Title"] = Localizer["Affiliate_EditTitle"];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-edit text-primary me-2"></i>@Localizer["Affiliate_EditTitle"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> @Localizer["Affiliate_BackBtn"]
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ProductCode" class="form-label fw-bold">@Localizer["Affiliate_ProductCodeLabel"]</label>
                        <input asp-for="ProductCode" class="form-control" required />
                        <span asp-validation-for="ProductCode" class="text-danger small"></span>
                        <div class="form-text">@Localizer["Affiliate_ProductCodeHelp"] <code>[[product:codigo]]</code></div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Network" class="form-label fw-bold">@Localizer["Affiliate_NetworkLabel"]</label>
                        <select asp-for="Network" class="form-select">
                            <option value="Amazon">Amazon</option>
                            <option value="Udemy">Udemy</option>
                            <option value="Hotmart">Hotmart</option>
                            <option value="Outro">Outro</option>
                        </select>
                        <span asp-validation-for="Network" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Category" class="form-label fw-bold">@Localizer["Affiliate_CategoryLabel"]</label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">@Localizer["Affiliate_PriceLabel"]</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Currency" class="form-label fw-bold">@Localizer["Affiliate_CurrencyLabel"]</label>
                        <input asp-for="Currency" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ExpirationDate" class="form-label fw-bold">@Localizer["Affiliate_ExpirationDateLabel"]</label>
                        <input asp-for="ExpirationDate" class="form-control" type="date" />
                        <div class="form-text">@Localizer["Affiliate_ExpirationDateHelp"]</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold">@Localizer["Affiliate_ImageUrlLabel"]</label>
                    <input asp-for="ImageUrl" class="form-control" />
                </div>

                <hr class="my-4" />
                <h5 class="fw-bold text-primary mb-3"><i class="fas fa-globe me-2"></i>@Localizer["Affiliate_LocalizedSectionTitle"]</h5>

                <div class="row">
                    <!-- Inglês -->
                    <div class="col-md-4 mb-3">
                        <div class="card p-3 bg-light border-0">
                            <h6 class="fw-bold text-dark">🇬🇧 @Localizer["Affiliate_EnglishSection"]</h6>
                            <div class="mb-2">
                                <label asp-for="Title_EN" class="form-label small fw-bold">@Localizer["Affiliate_TitleLabel"] (EN)</label>
                                <input asp-for="Title_EN" class="form-control form-control-sm" required />
                            </div>
                            <div class="mb-2">
                                <label asp-for="TargetUrl_EN" class="form-label small fw-bold">@Localizer["Affiliate_TargetUrlLabel"] (EN)</label>
                                <input asp-for="TargetUrl_EN" class="form-control form-control-sm" required />
                            </div>
                            <div class="mb-2">
                                <label asp-for="Description_EN" class="form-label small fw-bold">@Localizer["Affiliate_DescriptionLabel"] (EN)</label>
                                <textarea asp-for="Description_EN" class="form-control form-control-sm" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Português -->
                    <div class="col-md-4 mb-3">
                        <div class="card p-3 bg-light border-0">
                            <h6 class="fw-bold text-dark">🇧🇷 @Localizer["Affiliate_PortugueseSection"]</h6>
                            <div class="mb-2">
                                <label asp-for="Title_PT" class="form-label small fw-bold">@Localizer["Affiliate_TitleLabel"] (PT)</label>
                                <input asp-for="Title_PT" class="form-control form-control-sm" />
                            </div>
                            <div class="mb-2">
                                <label asp-for="TargetUrl_PT" class="form-label small fw-bold">@Localizer["Affiliate_TargetUrlLabel"] (PT)</label>
                                <input asp-for="TargetUrl_PT" class="form-control form-control-sm" />
                            </div>
                            <div class="mb-2">
                                <label asp-for="Description_PT" class="form-label small fw-bold">@Localizer["Affiliate_DescriptionLabel"] (PT)</label>
                                <textarea asp-for="Description_PT" class="form-control form-control-sm" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Francês -->
                    <div class="col-md-4 mb-3">
                        <div class="card p-3 bg-light border-0">
                            <h6 class="fw-bold text-dark">🇫🇷 @Localizer["Affiliate_FrenchSection"]</h6>
                            <div class="mb-2">
                                <label asp-for="Title_FR" class="form-label small fw-bold">@Localizer["Affiliate_TitleLabel"] (FR)</label>
                                <input asp-for="Title_FR" class="form-control form-control-sm" />
                            </div>
                            <div class="mb-2">
                                <label asp-for="TargetUrl_FR" class="form-label small fw-bold">@Localizer["Affiliate_TargetUrlLabel"] (FR)</label>
                                <input asp-for="TargetUrl_FR" class="form-control form-control-sm" />
                            </div>
                            <div class="mb-2">
                                <label asp-for="Description_FR" class="form-label small fw-bold">@Localizer["Affiliate_DescriptionLabel"] (FR)</label>
                                <textarea asp-for="Description_FR" class="form-control form-control-sm" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-5 fw-bold">
                        <i class="fas fa-save me-1"></i> @Localizer["Affiliate_UpdateBtn"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>