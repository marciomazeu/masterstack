@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model IEnumerable<MasterStack.Models.AffiliateProduct>

@{
    ViewData["Title"] = Localizer["Affiliate_PageTitle"];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-tags text-primary me-2"></i>@Localizer["Affiliate_PageTitle"]</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            <i class="fas fa-plus me-1"></i> @Localizer["Affiliate_NewProductBtn"]
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Localizer["Affiliate_ColCode"]</th>
                            <th>@Localizer["Affiliate_ColPlatform"]</th>
                            <th>@Localizer["Affiliate_ColTitle"]</th>
                            <th>@Localizer["Affiliate_ColExpiration"]</th>
                            <th>@Localizer["Affiliate_ColStatus"]</th>
                            <th class="text-end">@Localizer["Affiliate_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isExpired = item.ExpirationDate.HasValue && item.ExpirationDate.Value <= DateTime.UtcNow;
                            <tr>
                                <td><code class="fw-bold">@item.ProductCode</code></td>
                                <td><span class="badge bg-secondary">@item.Network</span></td>
                                <td>@item.Title_EN</td>
                                <td>
                                    @(item.ExpirationDate.HasValue ? item.ExpirationDate.Value.ToString("dd/MM/yyyy") : Localizer["Affiliate_NoExpiration"].Value)
                                </td>
                                <td>
                                    @if (!item.IsActive || isExpired)
                                    {
                                        <span class="badge bg-danger">@Localizer["Affiliate_StatusExpired"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Localizer["Affiliate_StatusActive"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i> @Localizer["Affiliate_EditRenewBtn"]
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">@Localizer["Affiliate_NoProductsFound"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>