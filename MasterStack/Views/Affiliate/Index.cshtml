@model IEnumerable<MasterStack.Models.AffiliateProduct>

@{
    ViewData["Title"] = "Gerenciar Afiliados";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-tags text-primary me-2"></i>Produtos de Afiliados</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            <i class="fas fa-plus me-1"></i> Novo Produto
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código / Slug</th>
                            <th>Plataforma</th>
                            <th>Título (EN)</th>
                            <th>Expiração</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isExpired = item.ExpirationDate.HasValue && item.ExpirationDate.Value <= DateTime.UtcNow;
                            <tr>
                                <td><code class="fw-bold">@item.ProductCode</code></td>
                                <td><span class="badge bg-secondary">@item.Network</span></td>
                                <td>@item.Title_EN</td>
                                <td>
                                    @(item.ExpirationDate.HasValue ? item.ExpirationDate.Value.ToString("dd/MM/yyyy") : "Sem expiração")
                                </td>
                                <td>
                                    @if (!item.IsActive || isExpired)
                                    {
                                        <span class="badge bg-danger">Inativo / Expirado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i> Editar / Renovar
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Nenhum produto de afiliado cadastrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>