@model MasterStack.ViewModels.AddTranslationViewModel

@{
    ViewData["Title"] = $"Adicionar Tradução - {Model.SelectedCulture}";
}

<style>
    /* Estilo igual ao Create */
    .image-preview-wrapper { border: 2px dashed #dee2e6; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fa; cursor: pointer; transition: 0.3s; }
    .image-preview-wrapper:hover { background: #e9ecef; }
    #imagePreview { max-height: 250px; display: none; margin: 10px auto; border-radius: 4px; }
    .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    .sticky-sidebar { position: sticky; top: 20px; }
    
    /* Ajuste Quill para bater com o layout */
    .ql-toolbar.ql-snow { border-top-left-radius: 8px; border-top-right-radius: 8px; background: #f8f9fa; border-color: #dee2e6; }
    .ql-container.ql-snow { border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-color: #dee2e6; font-size: 1rem; }
    
    /* Preview do Google */
    .google-preview { max-width: 600px; font-family: arial, sans-serif; }
    .google-title { color: #1a0dab; font-size: 20px; margin-bottom: 3px; cursor: pointer; }
    .google-url { color: #006621; font-size: 14px; margin-bottom: 3px; }
    .google-desc { color: #545454; font-size: 14px; line-height: 1.58; }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Nova Tradução</h1>
            <span class="badge bg-info text-dark">Idioma: @Model.SelectedCulture</span>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Voltar ao Dashboard
        </a>
    </div>

    <form id="addTranslationForm" asp-controller="BlogPosts" asp-action="AddTranslation" asp-route-postId="@Model.BlogPostId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BlogPostId" />
        <input type="hidden" asp-for="SelectedCulture" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Título da Tradução</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" placeholder="Digite o título..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Conteúdo</label>
                            <div id="quill-editor" style="height: 400px; background: white;">
                                @Html.Raw(Model.Content)
                            </div>
                            <input type="hidden" asp-for="Content" id="quill-content" />
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">
                        <h5 class="mb-3"><i class="fas fa-search me-2 text-muted"></i>SEO & Preview</h5>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Slug (URL)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">/@Model.SelectedCulture/blog/</span>
                                <input type="text" id="Slug" name="Slug" class="form-control" placeholder="slug-automatico" data-auto="true">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Meta Description</label>
                            <textarea id="MetaDescription" name="MetaDescription" class="form-control form-control-sm" rows="3" data-auto="true"></textarea>
                            <div id="descCounter" class="text-muted small mt-1">0 / 160 caracteres</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label small fw-bold">Palavras-chave (Separadas por vírgula)</label>
                            <input asp-for="MetaKeywords" class="form-control form-control-sm" placeholder="ex: dotnet, tutorial, aspnet" />
                            <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                        </div>

                        <div class="border rounded p-3 bg-white mt-4">
                            <small class="text-muted d-block mb-2">Preview no Google:</small>
                            <div class="google-preview">
                                <div class="google-title" id="preview-title">Título do Post</div>
                                <div class="google-url">https://seusite.com/@Model.SelectedCulture/blog/<span id="preview-slug">slug-do-post</span></div>
                                <div class="google-desc" id="preview-desc">A descrição aparecerá aqui conforme você escreve...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Imagem da Tradução</div>
                        <div class="card-body">
                            <div class="image-preview-wrapper" onclick="document.getElementById('ImageInput').click();">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-muted" id="uploadPlaceholder"></i>
                                <div id="uploadText" class="small text-muted">Clique para definir imagem</div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="ImageFile" type="file" class="d-none" id="ImageInput" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

<div class="card mb-4">
    <div class="card-header bg-white fw-bold">Status</div>
    <div class="card-body">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
            <label class="form-check-label fw-bold" for="publishSwitch">
                <span id="statusLabel" class="text-danger">Rascunho</span>
            </label>
        </div>
        <small class="text-muted d-block mt-2">
            Se desmarcado, o post não aparecerá na listagem pública.
        </small>
    </div>
</div>

                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="fas fa-save me-1"></i> Salvar Tradução
                            </button>
                            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-link w-100 btn-sm text-muted mt-2">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        // 1. Inicialização do Quill
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    ['link', 'image', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['clean']
                ]
            }
        });

        // 2. Seleção de Elementos (Apenas UMA vez)
        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');
        const sw = document.getElementById('publishSwitch');
        const label = document.getElementById('statusLabel');

        // 3. Funções Auxiliares
        function slugify(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, '-').replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
        }

        function extractPlainText(html) {
            var temp = document.createElement("div");
            temp.innerHTML = html;
            return temp.textContent || temp.innerText || "";
        }

        function updateGooglePreview() {
            document.getElementById('preview-title').innerText = titleInput.value || "Título do Post";
            document.getElementById('preview-slug').innerText = slugInput.value || "slug-do-post";
            document.getElementById('preview-desc').innerText = descField.value || "A descrição aparecerá aqui...";
            
            const count = descField.value.length;
            document.getElementById('descCounter').innerText = `${count} / 160 caracteres`;
            document.getElementById('descCounter').className = count >= 150 ? "text-danger small" : "text-muted small";
        }

        // 4. Eventos
        titleInput.addEventListener('input', function() {
            if (slugInput.dataset.auto !== "false") {
                slugInput.value = slugify(this.value);
            }
            updateGooglePreview();
        });

        slugInput.addEventListener('input', () => { 
            slugInput.dataset.auto = "false"; 
            updateGooglePreview(); 
        });

        quill.on('text-change', function() {
            if (descField.dataset.auto !== "false") {
                const plainText = extractPlainText(quill.root.innerHTML);
                descField.value = plainText.substring(0, 160).trim();
            }
            updateGooglePreview();
        });

        descField.addEventListener('input', () => { 
            descField.dataset.auto = "false"; 
            updateGooglePreview();
        });

        // Switch de Status
        const updateStatusLabel = () => {
            if (sw.checked) {
                label.innerText = "Publicado";
                label.className = "text-success fw-bold";
            } else {
                label.innerText = "Rascunho";
                label.className = "text-danger fw-bold";
            }
        };
        sw.addEventListener('change', updateStatusLabel);

        // 5. Submit do Formulário
        document.getElementById('addTranslationForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        // Inicialização
        updateStatusLabel();
        updateGooglePreview();
    </script>
}