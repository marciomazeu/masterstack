@model MasterStack.ViewModels.AddTranslationViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = $"{Localizer["AddTranslation"]} - {Model.SelectedCulture.ToUpper()}";
}

<style>
    .image-preview-wrapper { border: 2px dashed #dee2e6; border-radius: 8px; padding: 20px; text-align: center; background: #f8f9fa; cursor: pointer; transition: 0.3s; }
    .image-preview-wrapper:hover { background: #e9ecef; }
    #imagePreview { max-height: 250px; display: none; margin: 10px auto; border-radius: 4px; }
    .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    .sticky-sidebar { position: sticky; top: 20px; }
    
    .ql-toolbar.ql-snow { border-top-left-radius: 8px; border-top-right-radius: 8px; background: #f8f9fa; border-color: #dee2e6; }
    .ql-container.ql-snow { border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-color: #dee2e6; font-size: 1rem; }
    
    .google-preview { max-width: 600px; font-family: arial, sans-serif; }
    .google-title { color: #1a0dab; font-size: 20px; margin-bottom: 3px; cursor: pointer; }
    .google-url { color: #006621; font-size: 14px; margin-bottom: 3px; }
    .google-desc { color: #545454; font-size: 14px; line-height: 1.58; }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Localizer["AddTranslation"]</h1>
            <span class="badge bg-info text-dark">@Localizer["Language"]: @Model.SelectedCulture.ToUpper()</span>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["BackToDashboard"]
        </a>
    </div>

    <form id="addTranslationForm" asp-controller="BlogPosts" asp-action="AddTranslation" asp-route-postId="@Model.BlogPostId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BlogPostId" />
        <input type="hidden" asp-for="SelectedCulture" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["TranslationTitle"]</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" placeholder="@Localizer["TitlePlaceholder"]" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">@Localizer["PostContent"]</label>
                            <div id="quill-editor" style="height: 400px; background: white;">
                                @Html.Raw(Model.Content)
                            </div>
                            <input type="hidden" asp-for="Content" id="quill-content" />
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">
                        <h5 class="mb-3"><i class="fas fa-search me-2 text-muted"></i>@Localizer["SeoOptimization"]</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label small fw-bold">@Localizer["SlugUrl"]</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">/@Model.SelectedCulture/blog/</span>
                                <input asp-for="Slug" id="Slug" class="form-control" placeholder="slug-automatico" data-auto="true">
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label small fw-bold">@Localizer["MetaDescription"]</label>
                            <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control form-control-sm" rows="3" data-auto="true" maxlength="160"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                            <div id="descCounter" class="text-muted small mt-1">0 / 160 @Localizer["Characters"]</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label small fw-bold">@Localizer["MetaKeywords"]</label>
                            <input asp-for="MetaKeywords" class="form-control form-control-sm" placeholder="ex: dotnet, tutorial, aspnet" />
                            <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                        </div>

                        <div class="border rounded p-3 bg-white mt-4">
                            <small class="text-muted d-block mb-2">@Localizer["GooglePreview"]:</small>
                            <div class="google-preview">
                                <div class="google-title" id="preview-title">@Localizer["Title"]</div>
                                <div class="google-url">https://seusite.com/@Model.SelectedCulture/blog/<span id="preview-slug">...</span></div>
                                <div class="google-desc" id="preview-desc">...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["TranslationImage"]</div>
                        <div class="card-body">
                            <div class="image-preview-wrapper" onclick="document.getElementById('ImageInput').click();">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-muted" id="uploadPlaceholder"></i>
                                <div id="uploadText" class="small text-muted">@Localizer["ClickToSelectNew"]</div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="ImageFile" type="file" class="d-none" id="ImageInput" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["Status"]</div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
                                <label class="form-check-label fw-bold" for="publishSwitch">
                                    <span id="statusLabel" class="text-danger">@Localizer["Draft"]</span>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                @Localizer["DraftWarning"]
                            </small>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="fas fa-save me-1"></i> @Localizer["SaveTranslation"]
                            </button>
                            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-link w-100 btn-sm text-muted mt-2">@Localizer["Cancel"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    ['link', 'image', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['clean']
                ]
            }
        });

        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');
        const sw = document.getElementById('publishSwitch');
        const label = document.getElementById('statusLabel');

        function slugify(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, '-').replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
        }

        function extractPlainText(html) {
            var temp = document.createElement("div");
            temp.innerHTML = html;
            return temp.textContent || temp.innerText || "";
        }

        function updateGooglePreview() {
            document.getElementById('preview-title').innerText = titleInput.value || "@Localizer["Title"]";
            document.getElementById('preview-slug').innerText = slugInput.value || "...";
            document.getElementById('preview-desc').innerText = descField.value || "...";
            
            const count = descField.value.length;
            document.getElementById('descCounter').innerText = `${count} / 160 @Localizer["Characters"]`;
            document.getElementById('descCounter').className = count >= 150 ? "text-danger small" : "text-muted small";
        }

        const imageInput = document.getElementById('ImageInput');
        if (imageInput) {
            imageInput.onchange = evt => {
                const [file] = evt.target.files;
                if (file) {
                    const preview = document.getElementById('imagePreview');
                    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
                    const uploadText = document.getElementById('uploadText');

                    preview.src = URL.createObjectURL(file);
                    preview.style.display = 'block';
                    if (uploadPlaceholder) uploadPlaceholder.style.display = 'none';
                    if (uploadText) uploadText.style.display = 'none';
                }
            };
        }

        titleInput.addEventListener('input', function() {
            if (slugInput.dataset.auto !== "false") {
                slugInput.value = slugify(this.value);
            }
            updateGooglePreview();
        });

        slugInput.addEventListener('input', () => { 
            slugInput.dataset.auto = "false"; 
            updateGooglePreview(); 
        });

        quill.on('text-change', function() {
            if (descField.dataset.auto !== "false") {
                const plainText = extractPlainText(quill.root.innerHTML);
                descField.value = plainText.substring(0, 160).trim();
            }
            updateGooglePreview();
        });

        descField.addEventListener('input', () => { 
            descField.dataset.auto = "false"; 
            updateGooglePreview();
        });

        const updateStatusLabel = () => {
            if (sw.checked) {
                label.innerText = "@Localizer["Published"]";
                label.className = "text-success fw-bold";
            } else {
                label.innerText = "@Localizer["Draft"]";
                label.className = "text-danger fw-bold";
            }
        };
        sw.addEventListener('change', updateStatusLabel);

        document.getElementById('addTranslationForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        updateStatusLabel();
        updateGooglePreview();
    </script>
}