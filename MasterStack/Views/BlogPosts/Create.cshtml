@model MasterStack.Models.BlogPostCreateViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> Localizer
@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["CreatePageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
}

<style>
    .image-preview-wrapper {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

    .image-preview-wrapper:hover {
        background: #e9ecef;
    }

    #imagePreview {
        max-height: 200px;
        display: none;
        margin: 0 auto;
        border-radius: 4px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    /* Estilo para simular o Google */
    .google-preview-box {
        background-color: #fff;
        border: 1px solid #dfe1e5;
        border-radius: 8px;
        padding: 15px;
        max-width: 600px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@Localizer["CreatePageTitle"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["BackBtn"]
        </a>
    </div>

    <form asp-action="Create" asp-route-culture="@currentCulture" method="post" enctype="multipart/form-data" id="createForm">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["TitleLabel"]</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" placeholder="@Localizer["TitlePlaceholder"]" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Conteúdo do Post</label>
                            <div id="quill-editor" style="height: 450px; background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                @Html.Raw(Model?.Content)
                            </div>
                            <input type="hidden" name="Content" id="quill-content">
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-white fw-bold py-3">Otimização para Buscas (SEO)</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold small text-uppercase">URL Amigável (Slug)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted small">/blog/</span>
                                <input asp-for="Slug" id="Slug" class="form-control" placeholder="exemplo-de-url-amigavel" />
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label fw-bold small text-uppercase">Meta Description</label>
                            <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="3" maxlength="160" data-auto="false"></textarea>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small id="descCounter" class="badge bg-light text-muted border">0 / 160 caracteres</small>
                                
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="forceAutoDescription()">
                                    <i class="fas fa-magic me-1"></i> Sugerir baseada no texto
                                </button>
                            </div>
                        </div>

                        <hr />

                        <div class="google-preview-box">
                            <h6 class="text-muted small mb-2"><i class="fab fa-google"></i> Prévia do Google</h6>
                            <div style="font-family: arial, sans-serif;">
                                <div style="color: #202124; font-size: 14px; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    https://seusite.com/@currentCulture/blog/<span id="preview-slug">...</span>
                                </div>
                                <div id="preview-title" style="color: #1a0dab; font-size: 20px; line-height: 1.3; cursor: pointer; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    Título do Post
                                </div>
                                <div id="preview-desc" style="color: #4d5156; font-size: 14px; line-height: 1.58; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    Comece a escrever para ver o resumo aqui...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Configurações</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="SelectedCulture" class="form-label small">Idioma da Publicação</label>
                                <select asp-for="SelectedCulture" class="form-select">
                                    <option value="pt-BR">🇧🇷 Português</option>
                                    <option value="en-US">🇺🇸 Inglês</option>
                                    <option value="fr-CA">🇫🇷 Francais</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Imagem de Capa</div>
                        <div class="card-body">
                            <div class="image-preview-wrapper" onclick="document.getElementById('ImageInput').click();">
                                <div id="uploadPlaceholder">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-muted"></i>
                                    <div class="small text-muted">Clique para selecionar imagem</div>
                                </div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="ImageFile" type="file" class="d-none" id="ImageInput" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

<div class="card mb-4">
    <div class="card-header bg-white fw-bold">Status</div>
    <div class="card-body">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
            <label class="form-check-label fw-bold" for="publishSwitch">
                <span id="statusLabel" class="text-danger">Rascunho</span>
            </label>
        </div>
        <small class="text-muted d-block mt-2">
            Se desmarcado, o post não aparecerá na listagem pública.
        </small>
    </div>
</div>
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-success w-100 mb-2 py-2 fw-bold">Publicar Post</button>
                            <a asp-action="Index" class="btn btn-light w-100 btn-sm text-muted border">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        // 1. Inicialização do Quill
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        ['link', 'image', 'code-block'],
                        ['clean']
                    ],
                    handlers: { image: imageHandler }
                }
            }
        });

        // 2. Upload de Imagem no Editor
        async function imageHandler() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();
            input.onchange = async () => {
                const file = input.files[0];
                const formData = new FormData();
                formData.append('image', file);
                const response = await fetch(`/@currentCulture/BlogPosts/UploadEditorImage`, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                if (response.ok) {
                    const result = await response.json();
                    const range = quill.getSelection();
                    quill.insertEmbed(range.index, 'image', result.url);
                }
            };
        }

        // 3. Funções Auxiliares de Texto
        function slugify(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, '-')
                .replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-')
                .replace(/^-+/, '').replace(/-+$/, '');
        }

        function extractPlainText(html) {
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = html;
            return (tempDiv.textContent || tempDiv.innerText || "").replace(/\s+/g, ' ').trim();
        }

        // 4. Lógica de SEO em Tempo Real
        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');

        titleInput.addEventListener('input', function() {
            if (slugInput.value === "" || slugInput.dataset.auto === "true") {
                slugInput.value = slugify(this.value);
                slugInput.dataset.auto = "true";
            }
            updateGooglePreview();
        });

        slugInput.addEventListener('input', () => { 
            slugInput.dataset.auto = "false"; 
            updateGooglePreview(); 
        });

        quill.on('text-change', function() {
            if (descField.value === "" || descField.dataset.auto === "true") {
                forceAutoDescription();
            }
            updateGooglePreview();
        });

        descField.addEventListener('input', () => { 
            descField.dataset.auto = "false"; 
            updateGooglePreview();
            updateCounter();
        });

        function forceAutoDescription() {
            // 1. Pega o HTML do Quill
            const html = quill.root.innerHTML;
            // 2. Limpa o HTML para texto puro
            const plainText = extractPlainText(html);
            // 3. Alimenta o campo de Meta Description
            const descField = document.getElementById('MetaDescription');
            descField.value = plainText.substring(0, 160);
            
            // 4. Atualiza o contador e o preview do Google
            updateCounter();
            updateGooglePreview();
        }

        function updateCounter() {
            const count = descField.value.length;
            document.getElementById('descCounter').innerText = `${count} / 160 caracteres`;
            document.getElementById('descCounter').className = count >= 150 ? "text-danger small" : "text-muted small";
        }

        function updateGooglePreview() {
            document.getElementById('preview-title').innerText = titleInput.value || "Título do Post";
            document.getElementById('preview-slug').innerText = slugInput.value || "slug-do-post";
            document.getElementById('preview-desc').innerText = descField.value || "A descrição aparecerá aqui...";
        }

        // 5. Preview da Imagem de Capa
        document.getElementById('ImageInput').onchange = evt => {
            const [file] = document.getElementById('ImageInput').files;
            if (file) {
                document.getElementById('imagePreview').src = URL.createObjectURL(file);
                document.getElementById('imagePreview').style.display = 'block';
                document.getElementById('uploadPlaceholder').style.display = 'none';
            }
        };

        // 6. Envio do Formulário
        document.getElementById('createForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        window.onload = updateGooglePreview;

        // Script simples para mudar a cor e o texto do status dinamicamente
    const sw = document.getElementById('publishSwitch');
    const label = document.getElementById('statusLabel');
    
    const updateLabel = () => {
        label.innerText = sw.checked ? "Publicado" : "Rascunho";
        label.className = sw.checked ? "text-success fw-bold" : "text-danger fw-bold";
    };

    sw.addEventListener('change', updateLabel);
    window.addEventListener('load', updateLabel);
    </script>
}