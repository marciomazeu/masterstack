@model MasterStack.Models.BlogPostCreateViewModel
@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CreatePageTitle_BlogPostCreate"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var selectedCultureValue = Model?.SelectedCulture ?? currentCulture;
}

<style>
    .image-preview-wrapper {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

    .image-preview-wrapper:hover {
        background: #e9ecef;
    }

    #imagePreview {
        max-height: 200px;
        display: none;
        margin: 0 auto;
        border-radius: 4px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    .google-preview-box {
        background-color: #fff;
        border: 1px solid #dfe1e5;
        border-radius: 8px;
        padding: 15px;
        max-width: 600px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@Localizer["CreatePageTitle_BlogPostCreate"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["BackBtn_BlogPostCreate"]
        </a>
    </div>

    <form asp-action="Create" asp-controller="BlogPosts" asp-route-culture="@currentCulture" method="post" enctype="multipart/form-data" id="createForm">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["TitleLabel_BlogPostCreate"]</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" placeholder="@Localizer["TitlePlaceholder_BlogPostCreate"]" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@Localizer["PostContent_BlogPostCreate"]</label>
                            <div id="quill-editor" style="height: 450px; background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                @Html.Raw(Model?.Content)
                            </div>
                            <input type="hidden" asp-for="Content" id="quill-content">
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-white fw-bold py-3">@Localizer["SeoOptimization_BlogPostCreate"]</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold small text-uppercase">@Localizer["SlugLabel_BlogPostCreate"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted small">/blog/</span>
                                <input asp-for="Slug" id="Slug" class="form-control" placeholder="@Localizer["SlugPlaceholder_BlogPostCreate"]" />
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label fw-bold small text-uppercase">@Localizer["MetaDescriptionLabel_BlogPostCreate"]</label>
                            <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="3" maxlength="160" data-auto="false"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small id="descCounter" class="badge bg-light text-muted border">0 / 160 @Localizer["CharactersCount_BlogPostCreate"]</small>
                                
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="forceAutoDescription()">
                                    <i class="fas fa-magic me-1"></i> @Localizer["SuggestFromText_BlogPostCreate"]
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label small fw-bold">@Localizer["MetaKeywordsLabel_BlogPostCreate"]</label>
                            <input asp-for="MetaKeywords" class="form-control form-control-sm" placeholder="@Localizer["MetaKeywordsPlaceholder_BlogPostCreate"]" />
                            <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="google-preview-box">
                            <h6 class="text-muted small mb-2"><i class="fab fa-google"></i> @Localizer["GooglePreviewTitle_BlogPostCreate"]</h6>
                            <div style="font-family: arial, sans-serif;">
                                <div style="color: #202124; font-size: 14px; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    https://seusite.com/@currentCulture/blog/<span id="preview-slug">...</span>
                                </div>
                                <div id="preview-title" style="color: #1a0dab; font-size: 20px; line-height: 1.3; cursor: pointer; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @Localizer["DefaultPreviewTitle_BlogPostCreate"]
                                </div>
                                <div id="preview-desc" style="color: #4d5156; font-size: 14px; line-height: 1.58; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @Localizer["DefaultPreviewDesc_BlogPostCreate"]
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["SettingsHeader_BlogPostCreate"]</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="SelectedCulture" class="form-label small">@Localizer["PublicationLanguageLabel_BlogPostCreate"]</label>
                                <select asp-for="SelectedCulture" class="form-select">
                                    <option value="pt-BR" selected="@(selectedCultureValue == "pt-BR")">🇧🇷 @Localizer["LangPt_BlogPostCreate"]</option>
                                    <option value="en-US" selected="@(selectedCultureValue == "en-US")">🇺🇸 @Localizer["LangEn_BlogPostCreate"]</option>
                                    <option value="fr-CA" selected="@(selectedCultureValue == "fr-CA")">🇫🇷 @Localizer["LangFr_BlogPostCreate"]</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4 bg-light border-primary shadow-sm">
                        <div class="card-header bg-primary text-white fw-bold">🪄 @Localizer["AiAssistantHeader_BlogPostCreate"]</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">@Localizer["ArticleLengthLabel_BlogPostCreate"]</label>
                                <select id="aiLength" class="form-select form-select-sm">
                                    <option value="curto (cerca de 400 a 600 palavras)">@Localizer["OptionShort_BlogPostCreate"]</option>
                                    <option value="médio (cerca de 800 a 1000 palavras)" selected>@Localizer["OptionMedium_BlogPostCreate"]</option>
                                    <option value="longo (cerca de 1200 a 1500 palavras)">@Localizer["OptionLong_BlogPostCreate"]</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">@Localizer["PostTopicLabel_BlogPostCreate"]</label>
                                <div class="input-group">
                                    <input type="text" id="aiTopic" class="form-control" placeholder="@Localizer["TopicPlaceholder_BlogPostCreate"]">
                                    <button class="btn btn-primary" type="button" id="btnGenerateAi" onclick="generateContentWithAi()">
                                        <span id="aiSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                        @Localizer["GenerateBtn_BlogPostCreate"]
                                    </button>
                                </div>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-success text-uppercase">
                                    <i class="fas fa-user-edit me-1"></i> @Localizer["UserOpinionLabel_BlogPostCreate"]
                                </label>
                                <textarea id="userOpinion" class="form-control form-control-sm" rows="3" 
                                        placeholder="@Localizer["OpinionPlaceholder_BlogPostCreate"]"></textarea>
                                
                                <button type="button" class="btn btn-success btn-sm w-100 mt-2" id="btnRefineAi" onclick="refineContentWithAi()">
                                    <span id="aiRefineSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    <i class="fas fa-sync-alt me-1"></i> @Localizer["RefineBtn_BlogPostCreate"]
                                </button>
                            </div>

                            <hr />

                            <div class="bg-white p-3 rounded border">
                                <h6 class="fw-bold small text-muted text-uppercase mb-3">
                                    <i class="fas fa-shield-alt text-warning me-1"></i> @Localizer["AdSenseValidatorHeader_BlogPostCreate"]
                                </h6>
                                
                                <ul class="list-unstyled mb-0 small">
                                    <li class="mb-2 d-flex align-items-center" id="chk-length">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>@Localizer["ChkLengthDefault_BlogPostCreate"]</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center" id="chk-tables">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>@Localizer["ChkTablesDefault_BlogPostCreate"]</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center" id="chk-code">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>@Localizer["ChkCodeDefault_BlogPostCreate"]</span>
                                    </li>
                                    <li class="mb-0 d-flex align-items-center" id="chk-opinion">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>@Localizer["ChkOpinionDefault_BlogPostCreate"]</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["CoverImageHeader_BlogPostCreate"]</div>
                        <div class="card-body">
                            <div class="image-preview-wrapper" onclick="document.getElementById('ImageInput').click();">
                                <div id="uploadPlaceholder">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-muted"></i>
                                    <div class="small text-muted">@Localizer["UploadPlaceholderText_BlogPostCreate"]</div>
                                </div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="ImageFile" type="file" class="d-none" id="ImageInput" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["StatusHeader_BlogPostCreate"]</div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
                                <label class="form-check-label fw-bold" for="publishSwitch">
                                    <span id="statusLabel" class="text-danger">@Localizer["StatusDraft_BlogPostCreate"]</span>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                @Localizer["StatusWarning_BlogPostCreate"]
                            </small>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-success w-100 mb-2 py-2 fw-bold">@Localizer["SubmitBtn_BlogPostCreate"]</button>
                            <a asp-action="Index" class="btn btn-light w-100 btn-sm text-muted border">@Localizer["CancelBtn_BlogPostCreate"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        ['link', 'image', 'code-block'],
                        ['clean']
                    ],
                    handlers: { image: imageHandler }
                }
            }
        });

        async function imageHandler() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();
            input.onchange = async () => {
                const file = input.files[0];
                const formData = new FormData();
                formData.append('image', file);
                const response = await fetch(`/@currentCulture/BlogPosts/UploadEditorImage`, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                if (response.ok) {
                    const result = await response.json();
                    const range = quill.getSelection();
                    quill.insertEmbed(range.index, 'image', result.url);
                }
            };
        }

        function slugify(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, '-')
                .replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-')
                .replace(/^-+/, '').replace(/-+$/, '');
        }

        function extractPlainText(html) {
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = html;
            return (tempDiv.textContent || tempDiv.innerText || "").replace(/\s+/g, ' ').trim();
        }

        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');

        if (titleInput) {
            titleInput.addEventListener('input', function() {
                if (slugInput && (slugInput.value === "" || slugInput.dataset.auto === "true")) {
                    slugInput.value = slugify(this.value);
                    slugInput.dataset.auto = "true";
                }
                updateGooglePreview();
            });
        }

        if (slugInput) {
            slugInput.addEventListener('input', () => { 
                slugInput.dataset.auto = "false"; 
                updateGooglePreview(); 
            });
        }

        quill.on('text-change', function() {
            const df = document.getElementById('MetaDescription');
            if (!df) return; 

            if (df.value === "" || df.dataset.auto === "true") {
                forceAutoDescription();
            }
            updateGooglePreview();
            runAdSenseAnalyzer();
        });

        if (descField) {
            descField.addEventListener('input', () => { 
                descField.dataset.auto = "false"; 
                updateGooglePreview();
                updateCounter();
            });
        }

        function forceAutoDescription() {
            const html = quill.root.innerHTML;
            const plainText = extractPlainText(html);
            const df = document.getElementById('MetaDescription');
            if (!df) return;

            df.value = plainText.substring(0, 160);
            updateCounter();
            updateGooglePreview();
        }

        function updateCounter() {
            const df = document.getElementById('MetaDescription');
            const counter = document.getElementById('descCounter');
            if (!df || !counter) return;

            const count = df.value.length;
            counter.innerText = `${count} / 160 @Localizer["CharactersCount_BlogPostCreate"]`;
            counter.className = count >= 150 ? "text-danger small" : "text-muted small";
        }

        function updateGooglePreview() {
            const ti = document.getElementById('Title');
            const si = document.getElementById('Slug');
            const df = document.getElementById('MetaDescription');

            const pTitle = document.getElementById('preview-title');
            const pSlug = document.getElementById('preview-slug');
            const pDesc = document.getElementById('preview-desc');

            if(pTitle) pTitle.innerText = (ti && ti.value) ? ti.value : "@Localizer["DefaultPreviewTitle_BlogPostCreate"]";
            if(pSlug) pSlug.innerText = (si && si.value) ? si.value : "slug-do-post";
            if(pDesc) pDesc.innerText = (df && df.value) ? df.value : "@Localizer["DefaultPreviewDesc_BlogPostCreate"]";
        }

        const imageInputEl = document.getElementById('ImageInput');
        if (imageInputEl) {
            imageInputEl.onchange = evt => {
                const [file] = imageInputEl.files;
                if (file) {
                    const preview = document.getElementById('imagePreview');
                    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
                    
                    preview.src = URL.createObjectURL(file);
                    preview.style.display = 'block';
                    if (uploadPlaceholder) uploadPlaceholder.style.display = 'none';
                }
            };
        }

        document.getElementById('createForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        const sw = document.getElementById('publishSwitch');
        const label = document.getElementById('statusLabel');
        
        const updateLabel = () => {
            if(!sw || !label) return;
            label.innerText = sw.checked ? "@Localizer["StatusPublished_BlogPostCreate"]" : "@Localizer["StatusDraft_BlogPostCreate"]";
            label.className = sw.checked ? "text-success fw-bold" : "text-danger fw-bold";
        };

        if(sw) {
            sw.addEventListener('change', updateLabel);
        }

        async function generateContentWithAi() {
            const topicEl = document.getElementById('aiTopic');
            const lengthEl = document.getElementById('aiLength');
            const opinionEl = document.getElementById('userOpinion');

            if (!topicEl) return alert('@Localizer["JsAlertFieldNotFound_BlogPostCreate"]');
            const topic = topicEl.value.trim();

            if (!topic) return alert('@Localizer["JsAlertTopicEmpty_BlogPostCreate"]');

            const selectedCultureEl = document.querySelector('select[name="SelectedCulture"]');
            const culture = selectedCultureEl ? selectedCultureEl.value : '@currentCulture';
            const length = lengthEl ? lengthEl.value : 'médio (cerca de 800 a 1000 palavras)';
            const opinion = opinionEl ? opinionEl.value.trim() : '';

            document.getElementById('aiSpinner').classList.remove('d-none');
            document.getElementById('btnGenerateAi').disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch(`/${culture}/Admin/GenerateAiContent`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `topic=${encodeURIComponent(topic)}&culture=${encodeURIComponent(culture)}&length=${encodeURIComponent(length)}&opinion=${encodeURIComponent(opinion)}`
                });

                if (!response.ok) throw new Error('@Localizer["JsErrorServerError_BlogPostCreate"] ' + response.status + ')');

                const data = await response.json();
                
                if (titleInput) titleInput.value = data.title || '';
                if (slugInput) {
                    slugInput.value = data.slug || '';
                    slugInput.dataset.auto = "false";
                }
                if (descField) descField.value = data.metaDescription || '';
                
                quill.root.innerHTML = data.content || '';
                
                updateGooglePreview();
                updateCounter();
                runAdSenseAnalyzer();

            } catch (error) {
                alert('@Localizer["JsAlertGenFailed_BlogPostCreate"]: ' + error.message);
            } finally {
                document.getElementById('aiSpinner').classList.add('d-none');
                document.getElementById('btnGenerateAi').disabled = false;
            }
        }

        async function refineContentWithAi() {
            const currentContent = quill.root.innerHTML.trim();
            const opinionEl = document.getElementById('userOpinion');
            if(!opinionEl) return;
            
            const opinion = opinionEl.value.trim();
            const selectedCultureEl = document.querySelector('select[name="SelectedCulture"]');
            const culture = selectedCultureEl ? selectedCultureEl.value : '@currentCulture';

            const currentTitle = titleInput ? titleInput.value : '';
            const currentSlug = slugInput ? slugInput.value : '';
            const currentMeta = descField ? descField.value : '';

            if (!opinion) return alert('@Localizer["JsAlertOpinionEmpty_BlogPostCreate"]');
            if (currentContent === '<p><br></p>' || !currentContent) return alert('@Localizer["JsAlertContentEmpty_BlogPostCreate"]');

            document.getElementById('aiRefineSpinner').classList.remove('d-none');
            document.getElementById('btnRefineAi').disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch(`/${culture}/Admin/RefineAiContent`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `culture=${encodeURIComponent(culture)}&opinion=${encodeURIComponent(opinion)}&currentContent=${encodeURIComponent(currentContent)}`
                });

                if (!response.ok) throw new Error('@Localizer["JsErrorRefineReq_BlogPostCreate"]');

                const data = await response.json();
                
                quill.root.innerHTML = data.content || '';
                
                if (titleInput) titleInput.value = data.title || currentTitle;
                if (slugInput) slugInput.value = data.slug || currentSlug;
                if (descField) descField.value = data.metaDescription || currentMeta;
                
                opinionEl.value = '';
                
                updateGooglePreview();
                updateCounter();
                runAdSenseAnalyzer();

            } catch (error) {
                alert('@Localizer["JsAlertRefineFailed_BlogPostCreate"]: ' + error.message);
            } finally {
                document.getElementById('aiRefineSpinner').classList.add('d-none');
                document.getElementById('btnRefineAi').disabled = false;
            }
        }

        function runAdSenseAnalyzer() {
            const html = quill.root.innerHTML;
            const plainText = extractPlainText(html);
            const wordCount = plainText.split(/\s+/).filter(w => w.length > 0).length;

            const chkLength = document.getElementById('chk-length');
            if (chkLength) {
                if (wordCount >= 600) {
                    chkLength.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>@Localizer["AdSenseDenseText_BlogPostCreate"] (${wordCount} @Localizer["Words_BlogPostCreate"])</span>`;
                } else {
                    chkLength.innerHTML = `<i class="fas fa-exclamation-circle text-danger me-2"></i> <span>@Localizer["AdSenseTooShort_BlogPostCreate"] (${wordCount}/600 @Localizer["Words_BlogPostCreate"])</span>`;
                }
            }

            const chkTables = document.getElementById('chk-tables');
            if (chkTables) {
                if (html.includes('<table')) {
                    chkTables.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>@Localizer["AdSenseHasTables_BlogPostCreate"]</span>`;
                } else {
                    chkTables.innerHTML = `<i class="fas fa-times-circle text-muted me-2"></i> <span>@Localizer["AdSenseTipAddTable_BlogPostCreate"]</span>`;
                }
            }

            const chkCode = document.getElementById('chk-code');
            if (chkCode) {
                if (html.includes('<pre') || html.includes('<code')) {
                    chkCode.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>@Localizer["AdSenseHasCode_BlogPostCreate"]</span>`;
                } else {
                    chkCode.innerHTML = `<i class="fas fa-times-circle text-muted me-2"></i> <span>@Localizer["AdSenseTipAddCode_BlogPostCreate"]</span>`;
                }
            }

            const chkOpinion = document.getElementById('chk-opinion');
            if (chkOpinion) {
                if (html.includes('<strong>Nota do Autor:</strong>') || html.includes('<strong>Author Note:</strong>') || html.includes('<strong>Note de l\'auteur:</strong>')) {
                    chkOpinion.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>@Localizer["AdSenseHasHumanTouch_BlogPostCreate"]</span>`;
                } else {
                    chkOpinion.innerHTML = `<i class="fas fa-times-circle text-danger me-2"></i> <span>@Localizer["AdSenseMissingPersonalExp_BlogPostCreate"]</span>`;
                }
            }
        }

        window.addEventListener('load', () => {
            updateGooglePreview();
            updateLabel();
            runAdSenseAnalyzer();
        });
    </script>
}