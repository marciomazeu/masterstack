@model MasterStack.Models.BlogPostCreateViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> Localizer
@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["CreatePageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
}

<style>
    .image-preview-wrapper {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

    .image-preview-wrapper:hover {
        background: #e9ecef;
    }

    #imagePreview {
        max-height: 200px;
        display: none;
        margin: 0 auto;
        border-radius: 4px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    /* Estilo para simular o Google */
    .google-preview-box {
        background-color: #fff;
        border: 1px solid #dfe1e5;
        border-radius: 8px;
        padding: 15px;
        max-width: 600px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">@Localizer["CreatePageTitle"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["BackBtn"]
        </a>
    </div>

    <form asp-action="Create" asp-route-culture="@currentCulture" method="post" enctype="multipart/form-data" id="createForm">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["TitleLabel"]</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" placeholder="@Localizer["TitlePlaceholder"]" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Conteúdo do Post</label>
                            <div id="quill-editor" style="height: 450px; background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                @Html.Raw(Model?.Content)
                            </div>
                            <input type="hidden" name="Content" id="quill-content">
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-white fw-bold py-3">Otimização para Buscas (SEO)</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold small text-uppercase">URL Amigável (Slug)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted small">/blog/</span>
                                <input asp-for="Slug" id="Slug" class="form-control" placeholder="exemplo-de-url-amigavel" />
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label fw-bold small text-uppercase">Meta Description</label>
                            <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="3" maxlength="160" data-auto="false"></textarea>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small id="descCounter" class="badge bg-light text-muted border">0 / 160 caracteres</small>
                                
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="forceAutoDescription()">
                                    <i class="fas fa-magic me-1"></i> Sugerir baseada no texto
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label small fw-bold">Palavras-chave (Separadas por vírgula)</label>
                            <input asp-for="MetaKeywords" class="form-control form-control-sm" placeholder="ex: dotnet, tutorial, aspnet" />
                            <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="google-preview-box">
                            <h6 class="text-muted small mb-2"><i class="fab fa-google"></i> Prévia do Google</h6>
                            <div style="font-family: arial, sans-serif;">
                                <div style="color: #202124; font-size: 14px; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    https://seusite.com/@currentCulture/blog/<span id="preview-slug">...</span>
                                </div>
                                <div id="preview-title" style="color: #1a0dab; font-size: 20px; line-height: 1.3; cursor: pointer; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    Título do Post
                                </div>
                                <div id="preview-desc" style="color: #4d5156; font-size: 14px; line-height: 1.58; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    Comece a escrever para ver o resumo aqui...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Configurações</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="SelectedCulture" class="form-label small">Idioma da Publicação</label>
                                <select asp-for="SelectedCulture" class="form-select">
                                    <option value="pt-BR">🇧🇷 Português</option>
                                    <option value="en-US">🇺🇸 Inglês</option>
                                    <option value="fr-CA">🇫🇷 Francais</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4 bg-light border-primary shadow-sm">
                        <div class="card-header bg-primary text-white fw-bold">🪄 Assistente de Escrita Inteligente</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Tamanho do Artigo</label>
                                <select id="aiLength" class="form-select form-select-sm">
                                    <option value="curto (cerca de 400 a 600 palavras)">Curto (Notícia / Rápido)</option>
                                    <option value="médio (cerca de 800 a 1000 palavras)" selected>Médio (Padrão Blog)</option>
                                    <option value="longo (cerca de 1200 a 1500 palavras)">Longo (Completo / SEO Avançado)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Tema do Post</label>
                                <div class="input-group">
                                    <input type="text" id="aiTopic" class="form-control" placeholder="Ex: Melhores práticas no EF Core...">
                                    <button class="btn btn-primary" type="button" id="btnGenerateAi" onclick="generateContentWithAi()">
                                        <span id="aiSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                        Gerar
                                    </button>
                                </div>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-success text-uppercase">
                                    <i class="fas fa-user-edit me-1"></i> Sua Opinião / Melhorias para o Rascunho
                                </label>
                                <textarea id="userOpinion" class="form-control form-control-sm" rows="3" 
                                        placeholder="Ex: Adicione um parágrafo sobre performance e inclua uma tabela comparativa..."></textarea>
                                
                                <button type="button" class="btn btn-success btn-sm w-100 mt-2" id="btnRefineAi" onclick="refineContentWithAi()">
                                    <span id="aiRefineSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    <i class="fas fa-sync-alt me-1"></i> Refinar Rascunho Atual com Minha Opinião
                                </button>
                            </div>

                            <hr />

                            <div class="bg-white p-3 rounded border">
                                <h6 class="fw-bold small text-muted text-uppercase mb-3">
                                    <i class="fas fa-shield-alt text-warning me-1"></i> Validador Google AdSense
                                </h6>
                                
                                <ul class="list-unstyled mb-0 small">
                                    <li class="mb-2 d-flex align-items-center" id="chk-length">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>Mínimo de 600 palavras</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center" id="chk-tables">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>Possui tabelas estruturadas</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center" id="chk-code">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>Possui blocos de código prático</span>
                                    </li>
                                    <li class="mb-0 d-flex align-items-center" id="chk-opinion">
                                        <i class="fas fa-circle text-danger me-2 font-xs"></i> <span>Contém o Toque Humano (Sua Opinião)</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Imagem de Capa</div>
                        <div class="card-body">
                            <div class="image-preview-wrapper" onclick="document.getElementById('ImageInput').click();">
                                <div id="uploadPlaceholder">
                                    <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-muted"></i>
                                    <div class="small text-muted">Clique para selecionar imagem</div>
                                </div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="ImageFile" type="file" class="d-none" id="ImageInput" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Status</div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
                                <label class="form-check-label fw-bold" for="publishSwitch">
                                    <span id="statusLabel" class="text-danger">Rascunho</span>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Se desmarcado, o post não aparecerá na listagem pública.
                            </small>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-success w-100 mb-2 py-2 fw-bold">Publicar Post</button>
                            <a asp-action="Index" class="btn btn-light w-100 btn-sm text-muted border">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        // 1. Inicialização do Quill
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        ['link', 'image', 'code-block'],
                        ['clean']
                    ],
                    handlers: { image: imageHandler }
                }
            }
        });

        // 2. Upload de Imagem no Editor
        async function imageHandler() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();
            input.onchange = async () => {
                const file = input.files[0];
                const formData = new FormData();
                formData.append('image', file);
                const response = await fetch(`/@currentCulture/BlogPosts/UploadEditorImage`, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                if (response.ok) {
                    const result = await response.json();
                    const range = quill.getSelection();
                    quill.insertEmbed(range.index, 'image', result.url);
                }
            };
        }

        // 3. Funções Auxiliares de Texto
        function slugify(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, '-')
                .replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-')
                .replace(/^-+/, '').replace(/-+$/, '');
        }

        function extractPlainText(html) {
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = html;
            return (tempDiv.textContent || tempDiv.innerText || "").replace(/\s+/g, ' ').trim();
        }

        // 4. Lógica de SEO em Tempo Real
        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');

        if (titleInput) {
            titleInput.addEventListener('input', function() {
                if (slugInput && (slugInput.value === "" || slugInput.dataset.auto === "true")) {
                    slugInput.value = slugify(this.value);
                    slugInput.dataset.auto = "true";
                }
                updateGooglePreview();
            });
        }

        if (slugInput) {
            slugInput.addEventListener('input', () => { 
                slugInput.dataset.auto = "false"; 
                updateGooglePreview(); 
            });
        }

        // Monitora o texto do editor para atualizar metadados e validador
        quill.on('text-change', function() {
            const df = document.getElementById('MetaDescription');
            if (!df) return; 

            if (df.value === "" || df.dataset.auto === "true") {
                forceAutoDescription();
            }
            updateGooglePreview();
            runAdSenseAnalyzer();
        });

        if (descField) {
            descField.addEventListener('input', () => { 
                descField.dataset.auto = "false"; 
                updateGooglePreview();
                updateCounter();
            });
        }

        function forceAutoDescription() {
            const html = quill.root.innerHTML;
            const plainText = extractPlainText(html);
            const df = document.getElementById('MetaDescription');
            if (!df) return;

            df.value = plainText.substring(0, 160);
            updateCounter();
            updateGooglePreview();
        }

        function updateCounter() {
            const df = document.getElementById('MetaDescription');
            const counter = document.getElementById('descCounter');
            if (!df || !counter) return;

            const count = df.value.length;
            counter.innerText = `${count} / 160 caracteres`;
            counter.className = count >= 150 ? "text-danger small" : "text-muted small";
        }

        function updateGooglePreview() {
            const ti = document.getElementById('Title');
            const si = document.getElementById('Slug');
            const df = document.getElementById('MetaDescription');

            const pTitle = document.getElementById('preview-title');
            const pSlug = document.getElementById('preview-slug');
            const pDesc = document.getElementById('preview-desc');

            if(pTitle) pTitle.innerText = (ti && ti.value) ? ti.value : "Título do Post";
            if(pSlug) pSlug.innerText = (si && si.value) ? si.value : "slug-do-post";
            if(pDesc) pDesc.innerText = (df && df.value) ? df.value : "A descrição aparecerá aqui...";
        }

        // 5. Preview da Imagem de Capa
        document.getElementById('ImageInput').onchange = evt => {
            const [file] = document.getElementById('ImageInput').files;
            if (file) {
                document.getElementById('imagePreview').src = URL.createObjectURL(file);
                document.getElementById('imagePreview').style.display = 'block';
                document.getElementById('uploadPlaceholder').style.display = 'none';
            }
        };

        // 6. Envio do Formulário
        document.getElementById('createForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        // 7. Configurações de Status Switch
        const sw = document.getElementById('publishSwitch');
        const label = document.getElementById('statusLabel');
        
        const updateLabel = () => {
            if(!sw || !label) return;
            label.innerText = sw.checked ? "Publicado" : "Rascunho";
            label.className = sw.checked ? "text-success fw-bold" : "text-danger fw-bold";
        };

        if(sw) {
            sw.addEventListener('change', updateLabel);
        }

        // 8. Assistente de Escrita Inteligente com IA
        async function generateContentWithAi() {
            // 🔥 CORREÇÃO CRÍTICA: Captura 'aiTopic' que é o ID correto do input no HTML
            const topicEl = document.getElementById('aiTopic');
            const lengthEl = document.getElementById('aiLength');
            const opinionEl = document.getElementById('userOpinion');

            if (!topicEl) return alert('Campo de tema não encontrado.');
            const topic = topicEl.value.trim();

            if (!topic) return alert('O tema não pode estar vazio!');

            const culture = '@currentCulture';
            const length = lengthEl ? lengthEl.value : 'médio (cerca de 800 a 1000 palavras)';
            const opinion = opinionEl ? opinionEl.value.trim() : '';

            document.getElementById('aiSpinner').classList.remove('d-none');
            document.getElementById('btnGenerateAi').disabled = true;

            try {
                const response = await fetch('/pt-BR/Admin/GenerateAiContent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `topic=${encodeURIComponent(topic)}&culture=${encodeURIComponent(culture)}&length=${encodeURIComponent(length)}&opinion=${encodeURIComponent(opinion)}`
                });

                if (!response.ok) throw new Error('Erro na resposta do servidor (Status 500)');

                const data = await response.json();
                
                if (titleInput) titleInput.value = data.title || '';
                if (slugInput) {
                    slugInput.value = data.slug || '';
                    slugInput.dataset.auto = "false";
                }
                if (descField) descField.value = data.metaDescription || '';
                
                quill.root.innerHTML = data.content || '';
                
                updateGooglePreview();
                updateCounter();
                runAdSenseAnalyzer();

            } catch (error) {
                alert('Falha ao gerar conteúdo: ' + error.message);
            } finally {
                document.getElementById('aiSpinner').classList.add('d-none');
                document.getElementById('btnGenerateAi').disabled = false;
            }
        }

        async function refineContentWithAi() {
            const currentContent = quill.root.innerHTML.trim();
            const opinionEl = document.getElementById('userOpinion');
            if(!opinionEl) return;
            
            const opinion = opinionEl.value.trim();
            const culture = '@currentCulture';

            // 🔥 Mantém os metadados atuais do formulário para não perdê-los no postback
            const currentTitle = titleInput ? titleInput.value : '';
            const currentSlug = slugInput ? slugInput.value : '';
            const currentMeta = descField ? descField.value : '';

            if (!opinion) return alert('Digite o que você quer melhorar ou sua opinião antes de refinar!');
            if (currentContent === '<p><br></p>' || !currentContent) return alert('Não há nenhum texto no editor para ser refinado!');

            document.getElementById('aiRefineSpinner').classList.remove('d-none');
            document.getElementById('btnRefineAi').disabled = true;

            try {
                const response = await fetch('/pt-BR/Admin/RefineAiContent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `culture=${encodeURIComponent(culture)}&opinion=${encodeURIComponent(opinion)}&currentContent=${encodeURIComponent(currentContent)}`
                });

                if (!response.ok) throw new Error('Erro na requisição de refinamento da IA');

                const data = await response.json();
                
                quill.root.innerHTML = data.content || '';
                
                // 🔥 Mantém ou atualiza os inputs originais da tela
                if (titleInput) titleInput.value = data.title || currentTitle;
                if (slugInput) slugInput.value = data.slug || currentSlug;
                if (descField) descField.value = data.metaDescription || currentMeta;
                
                opinionEl.value = '';
                
                updateGooglePreview();
                updateCounter();
                runAdSenseAnalyzer();

            } catch (error) {
                alert('Falha ao refinar conteúdo: ' + error.message);
            } finally {
                document.getElementById('aiRefineSpinner').classList.add('d-none');
                document.getElementById('btnRefineAi').disabled = false;
            }
        }

        function runAdSenseAnalyzer() {
            const html = quill.root.innerHTML;
            const plainText = extractPlainText(html);
            const wordCount = plainText.split(/\s+/).filter(w => w.length > 0).length;

            const chkLength = document.getElementById('chk-length');
            if (chkLength) {
                if (wordCount >= 600) {
                    chkLength.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>Texto denso (${wordCount} palavras)</span>`;
                } else {
                    chkLength.innerHTML = `<i class="fas fa-exclamation-circle text-danger me-2"></i> <span>Muito curto (${wordCount}/600 palavras)</span>`;
                }
            }

            const chkTables = document.getElementById('chk-tables');
            if (chkTables) {
                if (html.includes('<table')) {
                    chkTables.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>Possui tabelas de comparação</span>`;
                } else {
                    chkTables.innerHTML = `<i class="fas fa-times-circle text-muted me-2"></i> <span>Dica: Adicione uma tabela comparativa</span>`;
                }
            }

            const chkCode = document.getElementById('chk-code');
            if (chkCode) {
                if (html.includes('<pre') || html.includes('<code')) {
                    chkCode.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>Possui exemplos de código</span>`;
                } else {
                    chkCode.innerHTML = `<i class="fas fa-times-circle text-muted me-2"></i> <span>Dica: Inclua blocos de código prático</span>`;
                }
            }

            const chkOpinion = document.getElementById('chk-opinion');
            if (chkOpinion) {
                if (html.includes('<strong>Nota do Autor:</strong>')) {
                    chkOpinion.innerHTML = `<i class="fas fa-check-circle text-success me-2"></i> <span>Contém o Toque Humano aplicado</span>`;
                } else {
                    chkOpinion.innerHTML = `<i class="fas fa-times-circle text-danger me-2"></i> <span>Falta incluir sua experiência pessoal</span>`;
                }
            }
        }

        // 9. Gatilhos de Inicialização Global
        window.addEventListener('load', () => {
            updateGooglePreview();
            updateLabel();
            runAdSenseAnalyzer();
        });
    </script>
}