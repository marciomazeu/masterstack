@model MasterStack.Models.BlogPost
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    // Pega a tradução atual para mostrar o que está sendo deletado
    var translation = Model.Translations.FirstOrDefault(t => t.Culture == currentCulture)
                     ?? Model.Translations.FirstOrDefault();
}

<div class="container py-5">
    <h3>@Localizer["ConfirmDelete"]</h3>
    <div class="card border-danger mb-4">
        <div class="card-body">
            <h4 class="card-title">@translation?.Title</h4>
            <p class="text-muted">ID: @Model.Id | Criado em: @Model.CreatedAt</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-culture="@currentCulture">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@Localizer["DeleteBtn"]</button>
        <a asp-action="Index" asp-route-culture="@currentCulture" class="btn btn-secondary">@Localizer["Cancel"]</a>
    </form>
</div>