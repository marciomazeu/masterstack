@using Microsoft.AspNetCore.Mvc.Localization
@model MasterStack.Models.BlogPost
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Details";
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;

    // Busca tradução atual ou a primeira disponível
    // 1. Pegamos a tradução que o Controller já escolheu e validou
    var t = ViewBag.CurrentTranslation as BlogPostTranslation;

    // 2. Pegamos o estado do aviso
    var isFallback = ViewBag.TranslationWarning != null && (bool)ViewBag.TranslationWarning;

    // 3. Definimos o título da página
    ViewData["Title"] = t?.Title ?? "Detalhes do Post";
    var principalTranslation = Model.Translations.FirstOrDefault();
}



<div class="container mt-4">
    @* Mensagem de Aviso (Apenas se estiver usando Fallback) *@
    @if (isFallback)
    {
        <div class="alert alert-info py-2">
            @if (currentCulture.StartsWith("en"))
            {
                <text>Content not available in English. Showing original version.</text>
            }
            else if (currentCulture.StartsWith("fr"))
            {

                <text>Contenu non disponible en Français. Affichage de la version originale.</text>
            }
            else
            {

                <text>Conteúdo não disponível em Português. Exibindo original.</text>
            }
        </div>
    }
    <div class="mb-4">

        <a asp-action="Index"
           asp-controller="BlogPosts"
           asp-route-culture="@currentCulture"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left"></i> @Localizer["BackToList"]

        </a>

    </div>
    @* @if (ViewBag.TranslationWarning == true)
    {
        <div class="alert alert-danger border-3">
            @if (currentCulture.StartsWith("en"))
            {
                <text>Content not available in English. Showing original version.</text>
            }
            else if (currentCulture.StartsWith("fr"))
            {

                <text>Contenu non disponible en Français. Affichage de la version originale.</text>
            }
            else
            {

                <text>Conteúdo não disponível em Português. Exibindo original.</text>
            }
        </div>
    } *@
    @if (t  != null)
    {
        <h1 class="mb-3">@t?.Title</h1>

        <div>
            @* <dt class="col-sm-2">Capa</dt> *@
            <dd class="col-sm-10">
                @if (t != null && !string.IsNullOrEmpty(t.ImageUrl))
                {
                    <img src="/uploads/blog/@t.ImageUrl" class="img-fluid" style="max-width:300px" />
                }
                else
                {
                    <span>Sem imagem disponível</span>
                }
            </dd>
        </div>

        <div class="post-content">
            @Html.Raw(t?.Content)
        </div>
    }
    else
    {
        <p class="text-danger">Conteúdo não encontrado.</p>
    }

    @* <div class="mt-5 border-top pt-3">
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div> *@
</div>