@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject MasterStack.Services.IAffiliateRenderService AffiliateRenderService
@model MasterStack.Models.BlogPost
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _webHostEnvironment

@{
    var request = Context.Request;
    var t = ViewBag.CurrentTranslation as BlogPostTranslation;
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    bool isFallback = ViewBag.TranslationWarning ?? false;
    
    // 💡 Definição segura da URL da imagem do post
    var imageFileName = "/images/default-post.jpg";

    if (t != null && !string.IsNullOrWhiteSpace(t.ImageUrl))
    {
        imageFileName = t.ImageUrl.StartsWith("/") ? t.ImageUrl : "/" + t.ImageUrl;
    }

    string parsedContent = string.Empty;
    if (t != null)
    {
        parsedContent = await AffiliateRenderService.ParseAffiliateShortcodesAsync(t.Content ?? string.Empty, currentCulture);
        ViewData["Title"] = t.Title;

        ViewBag.FinalImagePath = imageFileName;
        ViewData["MetaImage"] = $"{request.Scheme}://{request.Host}{imageFileName}";
        ViewData["CanonicalUrl"] = $"{request.Scheme}://{request.Host}{request.Path}";

        var plainText = System.Text.RegularExpressions.Regex.Replace(t.Content ?? "", "<.*?>", string.Empty);
        ViewData["MetaDescription"] = plainText.Length > 160 ? plainText.Substring(0, 157) + "..." : plainText;
    }

    // 🌐 Localização das variáveis do Autor
    string authorBio = string.Empty;
    if (Model.Author != null)
    {
        authorBio = currentCulture switch
        {
            "en-US" => !string.IsNullOrWhiteSpace(Model.Author.Bio_EN) ? Model.Author.Bio_EN : Model.Author.Bio,
            "fr-CA" => !string.IsNullOrWhiteSpace(Model.Author.Bio_FR) ? Model.Author.Bio_FR : Model.Author.Bio,
            _ => Model.Author.Bio
        } ?? string.Empty;
    }

    string writtenByLabel = currentCulture switch
    {
        "en-US" => "Written by",
        "fr-CA" => "Écrit par",
        _ => "Escrito por"
    };
}

@section Head {
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:image" content="@ViewData["MetaImage"]" />
    <meta property="og:url" content="@ViewData["CanonicalUrl"]" />
    <meta name="twitter:card" content="summary_large_image" />

    @if (Model.Translations != null)
    {
        foreach (var alt in Model.Translations)
        {
            <link rel="alternate" hreflang="@alt.Culture.ToLower()"
                  href="@Url.Action("Details", "BlogPosts", new { culture = alt.Culture, slug = alt.Slug }, request.Scheme)" />
        }
    }
}

<div class="container mt-4" style="max-width: 800px;">
    @if (ViewBag.ShowTranslationUnavailable == true)
    {
        <div class="alert alert-warning alert-dismissible fade show my-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>@SharedLocalizer["Blog_PostNotAvailableTitle"]</strong> 
            @SharedLocalizer["Blog_PostNotAvailableMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (isFallback)
    {
        <div class="alert alert-info py-2 shadow-sm my-3">
            <i class="fas fa-info-circle me-2"></i>
            @SharedLocalizer["FallbackWarning", currentCulture]
        </div>
    }

    <div class="mb-4">
        <a asp-action="Index" asp-controller="BlogPosts" asp-route-culture="@currentCulture" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> @SharedLocalizer["BackToList"]
        </a>
    </div>

    @if (t != null)
    {
        <h1 class="mb-3 fw-bold display-5">@t.Title</h1>
        
        <div class="text-muted mb-4 small d-flex align-items-center">
            <i class="far fa-calendar-alt me-2"></i>
            @Model.CreatedAt.ToString("D", new System.Globalization.CultureInfo(currentCulture))
            <span class="mx-2">|</span>
            <i class="far fa-clock me-2"></i> @SharedLocalizer["ReadingTime", "5 min"]
        </div>

        <div class="mb-5 text-center">
            <img src="@imageFileName" 
                class="img-fluid rounded-4 shadow-sm w-100" 
                style="max-height: 500px; object-fit: cover;" 
                fetchpriority="high" 
                alt="@(t?.Title ?? "Blog Post Image")" 
                onerror="this.onerror=null;this.src='/images/default-post.jpg';" />
        </div>

        <div class="post-content mb-5">
            @Html.Raw(parsedContent)
        </div>
    }

    @* Bloco do Autor Limpo e Dinâmico *@
    <section class="author-card p-4 bg-light rounded-4 border-0 shadow-sm my-5">
        <div class="d-flex align-items-center">
            @if (Model.Author != null)
            {
                <img src="@(string.IsNullOrEmpty(Model.Author?.ProfileImageUrl) ? "/images/default-avatar.png" : Model.Author.ProfileImageUrl)" 
                    alt="@Model.Author?.DisplayName" 
                    class="rounded-circle me-3 img-fluid" 
                    style="width: 80px; height: 80px; object-fit: cover;"
                    onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                
                <div class="flex-grow-1">
                    <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 1px;">@writtenByLabel</span>
                    <h5 class="mb-1 fw-bold">@(Model.Author?.DisplayName ?? Model.Author?.UserName)</h5>
                    
                    @if (!string.IsNullOrEmpty(Model.Author?.JobTitle))
                    {
                        <p class="text-primary small mb-1">@Model.Author.JobTitle</p>
                    }

                    @if (!string.IsNullOrEmpty(authorBio))
                    {
                        <p class="mb-0 text-secondary small">@authorBio</p>
                    }

                    <div class="d-flex gap-3 mt-2">
                        @if (!string.IsNullOrEmpty(Model.Author.LinkedInUrl)) {
                            <a href="@Model.Author.LinkedInUrl" target="_blank" class="text-secondary"><i class="fab fa-linkedin fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Author.TwitterUrl)) {
                            <a href="@Model.Author.TwitterUrl" target="_blank" class="text-secondary"><i class="fab fa-x-twitter fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Author.GitHubUrl)) {
                            <a href="@Model.Author.GitHubUrl" target="_blank" class="text-secondary"><i class="fab fa-github fa-lg"></i></a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="py-2">
                    <i class="fas fa-user-edit me-2 text-primary"></i> 
                    <span class="fw-bold">Equipe MasterStack</span>
                </div>
            }
        </div>
    </section>
</div>

@section Styles {
    <style>
        .post-content {
            line-height: 1.8;
            color: #2d3436;
            font-size: 1.15rem;
        }
        .post-content p { margin-bottom: 1.5rem; }
        
        /* 📱 Imagens responsivas no conteúdo do post para Mobile e Desktop */
        .post-content img { 
            max-width: 100% !important; 
            height: auto !important; 
            border-radius: 8px; 
            margin: 1.5rem auto; 
            display: block;
        }
        
        .author-card { transition: transform 0.2s; }
        .author-card:hover { transform: translateY(-3px); }
    </style>
}