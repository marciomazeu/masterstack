@using MasterStack.ViewModels
@model EditTranslationViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = $"{Localizer["Edit"]} - {Model.Culture}";
}

<style>
    .tox-tinymce-aux {
        z-index: 999999 !important;
    }

    .image-preview-wrapper {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
    }

    #imagePreview {
        max-height: 200px;
        display: none;
        margin: 10px auto;
        border-radius: 4px;
        border: 2px solid #28a745;
    }

    .current-image {
        max-height: 200px;
        border-radius: 4px;
        border: 1px solid #dee2e6;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    .badge-culture {
        font-size: 0.9rem;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Localizer["EditTranslation"]</h1>
            <span class="badge bg-primary badge-culture">@Model.Culture</span>
        </div>
        <a asp-action="Dashboard" asp-controller="Admin" asp-route-culture="@Model.Culture" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["Back"]
        </a>
    </div>

    <form asp-action="EditTranslation" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TranslationId" />
        <input type="hidden" asp-for="Culture" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["Título"]</label>
                            <input asp-for="Title" class="form-control form-control-lg" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Content" class="form-label fw-bold">@Localizer["Conteúdo"]</label>
                            <textarea asp-for="Content" id="Editor" class="form-control">@Model.Content</textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">@Localizer["Imagem de Capa"]</div>
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                            {
                                <div class="mb-3">
                                    <p class="small text-muted mb-1">Atual:</p>
                                    <img src="@Model.CurrentImageUrl" class="img-fluid current-image" alt="Atual" />
                                </div>
                            }

                            <div class="image-preview-wrapper" onclick="document.getElementById('NewImageInput').click();">
                                <i class="fas fa-exchange-alt fa-2x mb-2 text-muted"></i>
                                <div id="uploadText" class="small text-muted">@Localizer["Trocar Imagem"]</div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>

                            <input asp-for="NewImage" type="file" class="d-none" id="NewImageInput" accept="image/*" />
                            <span asp-validation-for="NewImage" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <button type="submit" onclick="if(typeof tinymce !== 'undefined') tinymce.triggerSave();" class="btn btn-primary w-100 mb-2 py-2">
                                <i class="fas fa-check me-1"></i> @Localizer["Salvar Alterações"]
                            </button>
                            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-light w-100 btn-sm">@Localizer["Cancelar"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.tiny.cloud/1/w1gfg8v2xnky4rm0419th9b2tist0w0smsck10vl080jp21g/tinymce/8/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        // Preview da Nova Imagem
        document.getElementById('NewImageInput').onchange = evt => {
            const [file] = evt.target.files;
            if (file) {
                const preview = document.getElementById('imagePreview');
                const text = document.getElementById('uploadText');

                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
                text.innerText = "Nova imagem selecionada";
            }
        }

        // TinyMCE (Versão estável e limpa)
        tinymce.init({
            selector: '#Editor',
            height: 500,
            plugins: 'anchor autolink charmap codesample link lists media table wordcount visualblocks emoticons',
            toolbar: 'undo redo | blocks bold italic | alignleft aligncenter alignright | bullist numlist outdent indent | link image codesample emoticons',
            menubar: false
        });
    </script>
}