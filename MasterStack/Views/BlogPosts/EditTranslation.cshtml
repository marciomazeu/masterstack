@model MasterStack.ViewModels.EditTranslationViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = $"{Localizer["EditTranslation"]} - {Model.Culture.ToUpper()}";
    var currentCulture = Model.Culture.ToLower();
}

<style>
    .image-preview-wrapper {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
    }

    .image-preview-wrapper:hover { background: #e9ecef; }

    #imagePreview {
        max-height: 200px;
        display: none;
        margin: 0 auto;
        border-radius: 4px;
    }

    .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }

    .sticky-sidebar { position: sticky; top: 20px; }

    .google-preview-box {
        background-color: #fff;
        border: 1px solid #dfe1e5;
        border-radius: 8px;
        padding: 15px;
        max-width: 600px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Localizer["EditTranslation"]</h1>
            <span class="badge bg-dark">@Model.Culture.ToUpper()</span>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" asp-route-culture="@Model.Culture" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> @Localizer["Cancel"]
        </a>
    </div>

    <form asp-controller="BlogPosts" asp-action="EditTranslation" asp-route-culture="@Model.Culture" asp-route-id="@Model.TranslationId" method="post" enctype="multipart/form-data" id="editForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TranslationId" />
        <input type="hidden" asp-for="Culture" />

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">@Localizer["Title"]</label>
                            <input asp-for="Title" id="Title" class="form-control form-control-lg" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Conteúdo do Post</label>
                            <div id="quill-editor" style="height: 450px; background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                @Html.Raw(Model.Content)
                            </div>
                            <input type="hidden" asp-for="Content" id="quill-content" />
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-white fw-bold py-3">Otimização para Buscas (SEO)</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold small text-uppercase">URL Amigável (Slug)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted small">/blog/</span>
                                <input asp-for="Slug" id="Slug" class="form-control" data-auto="false" />
                            </div>
                            <small class="text-muted" style="font-size: 0.7rem;">Cuidado: Alterar o slug quebra links já compartilhados.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label fw-bold small text-uppercase">Meta Description</label>
                            <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="3" maxlength="160" data-auto="false"></textarea>
                            <div class="d-flex justify-content-between mt-2">
                                <small id="descCounter" class="badge bg-light text-muted border">0 / 160 caracteres</small>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" onclick="forceAutoDescription()">
                                    <i class="fas fa-magic me-1"></i> Sugerir baseada no texto
                                </button>
                            </div>
                        </div>
                         <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label small fw-bold">Palavras-chave (Separadas por vírgula)</label>
                            <input asp-for="MetaKeywords" class="form-control form-control-sm" placeholder="ex: dotnet, tutorial, aspnet" />
                            <span asp-validation-for="MetaKeywords" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="google-preview-box">
                            <h6 class="text-muted small mb-2"><i class="fab fa-google"></i> Prévia do Google</h6>
                            <div style="font-family: arial, sans-serif;">
                                <div style="color: #202124; font-size: 14px; margin-bottom: 2px;">
                                    https://seusite.com/@currentCulture/blog/<span id="preview-slug">@Model.Slug</span>
                                </div>
                                <div id="preview-title" style="color: #1a0dab; font-size: 20px; line-height: 1.3; margin-bottom: 3px;">
                                    @Model.Title
                                </div>
                                <div id="preview-desc" style="color: #4d5156; font-size: 14px; line-height: 1.58;">
                                    @Model.MetaDescription
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="card mb-4">
                        <div class="card-header bg-white fw-bold">Imagem de Capa</div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                            {
                                <div class="text-center mb-3 p-2 border rounded bg-light" id="currentImageWrapper">
                                    <small class="d-block text-muted fw-bold mb-2">IMAGEM ATUAL</small>
                                    <img src="@Model.CurrentImageUrl" class="img-fluid rounded shadow-sm" style="max-height: 150px;">
                                </div>
                            }

                            <label class="form-label small fw-bold">Trocar Imagem</label>
                            <div class="image-preview-wrapper" onclick="document.getElementById('NewImageInput').click();">
                                <div id="uploadPlaceholder">
                                    <i class="fas fa-sync-alt fa-2x mb-2 text-muted"></i>
                                    <div class="small text-muted">Clique para selecionar nova</div>
                                </div>
                                <img id="imagePreview" src="#" alt="Preview" class="img-fluid" />
                            </div>
                            <input asp-for="NewImage" type="file" class="d-none" id="NewImageInput" accept="image/*" />
                        </div>
                    </div>

<div class="card mb-4">
    <div class="card-header bg-white fw-bold">Status</div>
    <div class="card-body">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch">
            <label class="form-check-label fw-bold" for="publishSwitch">
                <span id="statusLabel" class="text-danger">Rascunho</span>
            </label>
        </div>
        <small class="text-muted d-block mt-2">
            Se desmarcado, o post não aparecerá na listagem pública.
        </small>
    </div>
</div>
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary w-100 mb-2 py-2 fw-bold">
                                <i class="fas fa-save me-1"></i> Salvar Alterações
                            </button>
                            <a asp-controller="Admin" asp-action="Dashboard" asp-route-culture="@Model.Culture" class="btn btn-light w-100 btn-sm text-muted border">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: [[{ 'header': [1, 2, 3, false] }], ['bold', 'italic', 'underline'], ['link', 'image', 'code-block'], ['clean']]
            }
        });

        // Funções de SEO (Mesma lógica do Create)
        const titleInput = document.getElementById('Title');
        const slugInput = document.getElementById('Slug');
        const descField = document.getElementById('MetaDescription');

        function extractPlainText(html) {
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = html;
            return (tempDiv.textContent || tempDiv.innerText || "").replace(/\s+/g, ' ').trim();
        }

        function forceAutoDescription() {
            const plainText = extractPlainText(quill.root.innerHTML);
            descField.value = plainText.substring(0, 160);
            updateCounter();
            updateGooglePreview();
        }

        function updateCounter() {
            const count = descField.value.length;
            document.getElementById('descCounter').innerText = `${count} / 160 caracteres`;
            document.getElementById('descCounter').className = count >= 150 ? "badge bg-danger text-white border" : "badge bg-light text-muted border";
        }

        function updateGooglePreview() {
            document.getElementById('preview-title').innerText = titleInput.value || "Título";
            document.getElementById('preview-slug').innerText = slugInput.value || "...";
            document.getElementById('preview-desc').innerText = descField.value || "Descrição...";
        }

        titleInput.addEventListener('input', updateGooglePreview);
        slugInput.addEventListener('input', updateGooglePreview);
        descField.addEventListener('input', () => { updateCounter(); updateGooglePreview(); });

        // Preview da Nova Imagem
        document.getElementById('NewImageInput').onchange = evt => {
            const [file] = evt.target.files;
            if (file) {
                document.getElementById('imagePreview').src = URL.createObjectURL(file);
                document.getElementById('imagePreview').style.display = 'block';
                document.getElementById('uploadPlaceholder').style.display = 'none';
                if(document.getElementById('currentImageWrapper')) document.getElementById('currentImageWrapper').style.opacity = '0.4';
            }
        };

        document.getElementById('editForm').onsubmit = function() {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };

        window.onload = () => { updateCounter(); updateGooglePreview(); };

        // Script simples para mudar a cor e o texto do status dinamicamente
    const sw = document.getElementById('publishSwitch');
    const label = document.getElementById('statusLabel');
    
    const updateLabel = () => {
        label.innerText = sw.checked ? "Publicado" : "Rascunho";
        label.className = sw.checked ? "text-success fw-bold" : "text-danger fw-bold";
    };

    sw.addEventListener('change', updateLabel);
    window.addEventListener('load', updateLabel);
    </script>
}