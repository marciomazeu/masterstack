@using MasterStack.Models
@using Microsoft.AspNetCore.Mvc.Localization
@model IEnumerable<MasterStack.Models.BlogPost>
@inject IViewLocalizer Localizer

@{
    var supportedCultures = new[] { "pt-BR", "en-US", "fr-FR" };
    ViewData["Title"] = Localizer["PageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold text-primary">@Localizer["LatestPosts"]</h1>
        <a href="/@currentCulture/BlogPosts/Create" class="btn btn-success btn-lg shadow-sm">
            <i class="fas fa-plus"></i> @Localizer["NewPostBtn"]
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                // Busca a tradução para o idioma atual ou a primeira disponível (fallback)
                var translation = item.Translations.FirstOrDefault(t => t.Culture == currentCulture)
                ?? item.Translations.FirstOrDefault();

                if (translation != null)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            @{
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/uploads/default-post.jpg" : item.ImageUrl)"
                                     class="card-img-top object-fit-cover" style="height: 200px;" alt="@translation.Title">
                            }
                            @* <img src="@imgUrl" class="card-img-top object-fit-cover" style="height: 200px;" alt="@translation.Title"> *@

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">@translation.Title</h5>

                                @{
                                    var textoLimpo = System.Text.RegularExpressions.Regex.Replace(translation.Content ?? "", "<.*?>", String.Empty);
                                    var resumo = textoLimpo.Length > 130 ? textoLimpo.Substring(0, 130) + "..." : textoLimpo;
                                }

                                <p class="card-text text-muted" style="font-size: 0.9rem;">
                                    @resumo
                                </p>

                                <div class="mt-auto">
                                    @* Link usando o ID fixo e a Cultura *@
                                    <a href="/@currentCulture/BlogPosts/post/@item.Id" class="btn btn-primary w-100">
                                        @Localizer["ReadMore"]
                                    </a>
                                </div>
                            </div>

                            <div class="card-footer bg-transparent border-top-0 pb-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/@currentCulture/BlogPosts/Edit/@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                                    <a href="/@currentCulture/BlogPosts/Delete/@item.Id" class="btn btn-outline-danger btn-sm">Apagar</a>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2">

                                @foreach (var lang in (List<MasterStack.Models.Language>)ViewBag.Languages)
                                {
                                   currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
                                    bool jaExisteTraducao = item.Translations.Any(t => t.Culture == lang.Code);

                                    
                                    @* Só mostra o botão se não for a cultura atual e se a tradução não existir *@
                                    if (lang.Code != currentCulture && !jaExisteTraducao)
                                    {
                                        <a asp-action="AddTranslation"
                                           asp-route-id="@item.Id"
                                           asp-route-targetCulture="@lang.Code"
                                           class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center shadow-sm">

                                            @* A BANDEIRA AQUI *@
                                            <span class="@lang.FlagIcon me-2"></span>

                                            <span>Traduzir para @lang.Name</span>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>