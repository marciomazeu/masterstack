@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<MasterStack.Models.BlogPost>
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold text-primary">@Localizer["LatestPosts"]</h1>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="fas fa-plus"></i> @Localizer["NewPostBtn"]
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
{
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top object-fit-cover" alt="@item.Title" style="height: 200px;">
                    }
                    else
                    {
                        <img src="/img/no-image.jpg" class="card-img-top object-fit-cover" alt="Sem imagem" style="height: 200px;">
                    }

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-info text-dark">@item.Culture</span>
                            <small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-secondary text-truncate-3 card-text-custom">
                            @* Limita o texto para não quebrar o layout *@
                            @(item.Content.Length > 100 ? item.Content.Substring(0, 100) + "..." : item.Content)
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 pb-3">
                        <div class="d-grid gap-2 d-md-block">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Ler mais</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Apagar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        }
        else
        {
            <div class="alert alert-light text-center border shadow-sm p-5">
                <i class="bi bi-journal-x" style="font-size: 2rem;"></i>
                <p class="mt-3">@Localizer["NoPostsFound"]</p>
                <a asp-action="Create" class="btn btn-outline-primary btn-sm">
                    @Localizer["NewPostBtn"]
                </a>
            </div>
        }
    </div>
</div>
