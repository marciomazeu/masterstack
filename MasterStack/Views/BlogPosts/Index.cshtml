@model MasterStack.ViewModels.BlogPostListViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    
    ViewData["Title"] = Localizer["PageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold text-primary">@Localizer["LatestPosts"]</h1>
        
    </div>
    @* Se houver um termo de busca, mostramos o feedback e o botão de limpar *@
    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center shadow-sm mb-4">
            <span>
                <i class="fas fa-search text-muted me-2"></i>
                @Localizer["SearchResultsFor"]: <strong>"@ViewBag.SearchTerm"</strong>
            </span>

            <a asp-action="Index"
               asp-route-culture="@Model.Culture"
               class="btn btn-sm btn-outline-danger">
                <i class="fas fa-times me-1"></i> @Localizer["ClearSearch"]
            </a>
        </div>
    }
    @if (!Model.Posts.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-ghost fa-3x text-muted mb-3"></i>
            <h3>@Localizer["NoResultsTitle"].Value</h3>
            <p class="text-muted">@Localizer["NoResultsMessage"]</p>
            @* <a asp-action="Index" asp-route-culture="@Model.Culture" class="btn btn-primary">
                @Localizer["BackToBlog"]
            </a> *@
        </div>
    }
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Posts.Any())
        {
            @foreach (var item in Model.Posts)
            {
                var translation = item.Translations.FirstOrDefault(t => t.Culture == currentCulture)
                ?? item.Translations.FirstOrDefault();

                if (translation != null)
                {
                    <div class="col">
    <div class="card h-100 shadow-sm border-0 hover-lift transition-all">
        @* Imagem com proporção fixa 16:9 *@
        <div class="ratio ratio-16x9 overflow-hidden rounded-top">
            <img src="@(string.IsNullOrEmpty(translation.ImageUrl) ? "/uploads/default-post.jpg" : translation.ImageUrl)" 
                 class="card-img-top object-fit-cover w-100 h-100" 
                 alt="@translation.Title">
        </div>

        <div class="card-body d-flex flex-column p-4">
            @* Categoria ou Data *@
            <div class="mb-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-medium">
                    <i class="far fa-calendar-alt me-1"></i> @item.CreatedAt.ToString("dd MMM, yyyy")
                </span>
            </div>

            <h5 class="card-title fw-bold mb-3 text-dark">@translation.Title</h5>

            @{
                var textoLimpo = System.Text.RegularExpressions.Regex.Replace(translation.Content ?? "", "<.*?>", String.Empty);
                var resumo = textoLimpo.Length > 110 ? textoLimpo.Substring(0, 110) + "..." : textoLimpo;
            }

            <p class="card-text text-muted small flex-grow-1">@resumo</p>

            <hr class="my-3 opacity-10">

            @* Info do Autor no Rodapé do Card *@
            <div class="d-flex align-items-center justify-content-between mt-auto">
                <div class="d-flex align-items-center">
                    <img src="@(string.IsNullOrEmpty(item.Author?.ProfileImageUrl) ? "/img/default-avatar.png" : item.Author.ProfileImageUrl)" 
                        class="rounded-circle me-2" 
                        style="width: 32px; height: 32px; object-fit: cover; background-color: #eee;" 
                        alt="@(item.Author?.DisplayName ?? "Autor")">
                    <span class="small fw-bold text-secondary">@item.Author?.DisplayName</span>
                </div>
                
                <a asp-controller="BlogPosts" asp-action="Details" 
                   asp-route-culture="@currentCulture" 
                   asp-route-slug="@translation.Slug" 
                   class="btn btn-sm btn-link text-primary fw-bold text-decoration-none p-0">
                    @Localizer["ReadMore"] <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
                }
            }
        }
    </div>
        @* Controles de Paginação *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navegação de páginas" class="mt-5 mb-5">
                <ul class="pagination justify-content-center">

                    @* Botão Anterior *@
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-culture="@Model.Culture"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        &laquo;
                    </a>
                    </li>

                    @* Números das Páginas *@
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-culture="@Model.Culture"
                           asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                        </li>
                    }

                    @* Botão Próximo *@
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-culture="@Model.Culture"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        &raquo;
                    </a>
                    </li>
                </ul>
            </nav>
        }
</div>

@section Styles {
    <style>
        .hover-lift { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }
        .object-fit-cover { object-fit: cover; }
        .transition-all { transition: all 0.3s ease; }
        .pagination .page-link { border: none; color: #6c757d; margin: 0 3px; border-radius: 8px; }
        .pagination .page-item.active .page-link { background-color: #0d6efd; color: white; }
    </style>
}