@model MasterStack.ViewModels.BlogPostListViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    
    ViewData["Title"] = Localizer["PageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold text-primary">@Localizer["LatestPosts"]</h1>
        <a href="/@currentCulture/BlogPosts/Create" class="btn btn-success btn-lg shadow-sm">
            <i class="fas fa-plus"></i> @Localizer["NewPostBtn"]
        </a>
    </div>
    @* Se houver um termo de busca, mostramos o feedback e o botão de limpar *@
    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center shadow-sm mb-4">
            <span>
                <i class="fas fa-search text-muted me-2"></i>
                @Localizer["SearchResultsFor"]: <strong>"@ViewBag.SearchTerm"</strong>
            </span>

            <a asp-action="Index"
               asp-route-culture="@Model.Culture"
               class="btn btn-sm btn-outline-danger">
                <i class="fas fa-times me-1"></i> @Localizer["ClearSearch"]
            </a>
        </div>
    }
    @if (!Model.Posts.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-ghost fa-3x text-muted mb-3"></i>
            <h3>@Localizer["NoResultsTitle"]</h3>
            <p class="text-muted">@Localizer["NoResultsMessage"]</p>
            <a asp-action="Index" asp-route-culture="@Model.Culture" class="btn btn-primary">
                @Localizer["BackToBlog"]
            </a>
        </div>
    }
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Posts.Any())
        {
            @foreach (var item in Model.Posts)
            {
                var translation = item.Translations.FirstOrDefault(t => t.Culture == currentCulture)
                ?? item.Translations.FirstOrDefault();

                if (translation != null)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            @* Bloco de Imagem Corrigido *@
                            <div style="height: 200px; overflow: hidden;">
                                @* Note que agora usamos 'translation' em vez de 'item' *@
                                @if (translation != null && !string.IsNullOrEmpty(translation.ImageUrl))
                                {
                                    <img src="/uploads/blog/@translation.ImageUrl" class="card-img-top h-100 w-100 object-fit-cover" alt="@translation.Title">
                                }
                                else
                                {
                                    <img src="/uploads/default-post.jpg" class="card-img-top h-100 w-100 object-fit-cover" alt="Imagem Padrão">
                                }
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold">@translation.Title</h5>

                                @{
                                    var textoLimpo = System.Text.RegularExpressions.Regex.Replace(translation.Content ?? "", "<.*?>", String.Empty);
                                    var resumo = textoLimpo.Length > 130 ? textoLimpo.Substring(0, 130) + "..." : textoLimpo;
                                }

                                <p class="card-text text-muted" style="font-size: 0.9rem;">
                                    @resumo
                                </p>

                                <div class="mt-auto pt-3">
                                    <a asp-controller="BlogPosts"
                                       asp-action="Details"
                                       asp-route-culture="@currentCulture"
                                       asp-route-slug="@translation.Slug"
                                       class="btn btn-primary">
                                        @Localizer["ReadMore"]
                                    </a>
                                </div>
                            </div>

                            @* Footer com botões de tradução e edição *@
                            <div class="card-footer bg-light border-top-0 pb-3">
                                <div class="d-flex justify-content-between gap-2 mb-2">
                                    <a asp-action="Edit" 
                                    asp-route-id="@translation.Id" 
                                    asp-route-culture="@currentCulture" 
                                    class="btn btn-sm btn-outline-primary flex-grow-1">@Localizer["Edit"]</a>
                                    @* <a href="/@currentCulture/BlogPosts/Delete/@item.Id" class="btn btn-sm btn-outline-danger flex-grow-1">Apagar</a> *@
                                    @* Botão para apagar apenas esta tradução específica *@
                                    <form asp-action="DeleteTranslation" asp-route-id="@translation.Id" method="post"
                                          onsubmit="return confirm('Tem certeza que deseja apagar esta tradução? Se for a última, o post sumirá completamente.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Apagar esta versão</button>
                                    </form>
                                </div>

                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var lang in (List<MasterStack.Models.Language>)ViewBag.Languages)
                                    {
                                        bool jaExisteTraducao = item.Translations.Any(t => t.Culture == lang.Culture);
                                        if (lang.Culture != currentCulture && !jaExisteTraducao)
                                        {
                                            <a asp-action="AddTranslation"
                                               asp-route-id="@item.Id"
                                               asp-route-targetCulture="@lang.Culture"
                                               class="btn btn-xs btn-light border d-inline-flex align-items-center p-1" style="font-size: 0.75rem;">
                                                <span class="@lang.FlagClass me-1"></span>
                                                <span>+ @lang.Name</span>
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
        @* Controles de Paginação *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navegação de páginas" class="mt-5 mb-5">
                <ul class="pagination justify-content-center">

                    @* Botão Anterior *@
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-culture="@Model.Culture"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        &laquo;
                    </a>
                    </li>

                    @* Números das Páginas *@
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-culture="@Model.Culture"
                           asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                        </li>
                    }

                    @* Botão Próximo *@
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-culture="@Model.Culture"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        &raquo;
                    </a>
                    </li>
                </ul>
            </nav>
        }
</div>