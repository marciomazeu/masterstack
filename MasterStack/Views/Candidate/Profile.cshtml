@model MasterStack.Models.ViewModels.CandidateProfileViewModel
@{
    ViewData["Title"] = "Perfil do Candidato";
    var currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<div class="container py-4" style="max-width: 850px;">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            
            <!-- Cabeçalho Cadastral (Sempre Visível) -->
            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle bg-primary text-white me-3 d-flex align-items-center justify-content-center rounded-circle fw-bold fs-3" style="width: 65px; height: 65px;">
                    @(!string.IsNullOrEmpty(Model.Candidate.DisplayName) ? Model.Candidate.DisplayName.Substring(0, 1).ToUpper() : "C")
                </div>
                <div>
                    <h3 class="mb-0">@(Model.Candidate.DisplayName ?? "Candidato")</h3>
                    <p class="text-primary fw-semibold mb-0">@(Model.Candidate.PreferredJobTitle ?? "Desenvolvedor")</p>
                    <small class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i>@($"{Model.Candidate.City ?? "—"}, {Model.Candidate.StateOrRegion ?? "—"}")</small>
                </div>
            </div>

            <hr />

            @if (!Model.HasTranslation)
            {
                <!-- Estado Vazio: Currículo Indisponível no Idioma Atual -->
                <div class="text-center py-5 my-3">
                    <div class="mb-3">
                        <i class="bi bi-globe-americas text-muted display-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Currículo não disponível em @currentCulture.ToUpper()</h5>
                    <p class="text-muted mb-0">Este candidato ainda não cadastrou informações de currículo no idioma selecionado.</p>
                </div>
            }
            else
            {
                <!-- Bloco do CV (Renderiza normalmente apenas se houver tradução) -->
                
                <!-- Resumo -->
                <div class="mb-4">
                    <h5 class="fw-bold text-secondary mb-2"><i class="bi bi-person-text me-2"></i>Resumo Profissional</h5>
                    <div class="p-3 bg-light rounded">
                        <p class="mb-0" style="white-space: pre-line;">@Model.Summary</p>
                    </div>
                </div>

                <!-- Habilidades -->
                @if (Model.Skills.Any())
                {
                    <div class="mb-4">
                        <h5 class="fw-bold text-secondary mb-2"><i class="bi bi-tools me-2"></i>Habilidades & Competências</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge bg-secondary p-2 fs-6">@skill.Name</span>
                            }
                        </div>
                    </div>
                }

                <!-- Experiências -->
                @if (Model.Experiences.Any())
                {
                    <div class="mb-4">
                        <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-briefcase-fill me-2"></i>Experiência Profissional</h5>
                        <div class="vstack gap-3">
                            @foreach (var exp in Model.Experiences)
                            {
                                <div class="p-3 bg-light rounded border-start border-4 border-primary">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                                        <div>
                                            <h6 class="fw-bold mb-0">@exp.Position</h6>
                                            <span class="text-primary small fw-semibold">@exp.Company</span>
                                        </div>
                                        <small class="badge bg-white text-secondary border">
                                            @exp.StartDate.ToString("MM/yyyy") - @(exp.IsCurrent ? "Atual" : exp.EndDate?.ToString("MM/yyyy") ?? "—")
                                        </small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(exp.Description))
                                    {
                                        <p class="text-muted small mb-0 mt-2" style="white-space: pre-line;">@exp.Description</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Formações -->
                @if (Model.Educations.Any())
                {
                    <div class="mb-2">
                        <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-mortarboard-fill me-2"></i>Formação Acadêmica</h5>
                        <div class="list-group list-group-flush">
                            @foreach (var edu in Model.Educations)
                            {
                                <div class="list-group-item px-0 py-2">
                                    <h6 class="fw-bold mb-0">@edu.Degree</h6>
                                    <p class="text-muted small mb-0">@edu.Institution</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div>