@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model IEnumerable<MasterStack.Models.BlogPostTranslation>
@{
    ViewData["Title"] = Localizer["NotFound_Title"];
    Layout = "_Layout";
    var currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<style>
    .error-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .error-code {
        font-size: 8rem;
        font-weight: 800;
        color: #6366f1;
        opacity: 0.2;
        line-height: 1;
    }

    .error-illustration {
        max-width: 100%;
        height: auto;
        transform: scaleX(-1);
    }

    .card-error {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s;
    }

        .card-error:hover {
            transform: translateY(-5px);
        }

    .btn-rounded {
        border-radius: 50px;
        padding: 10px 25px;
    }
</style>

<div class="container error-container">
    <div class="row w-100 align-items-center">
        <div class="col-lg-6 text-center text-lg-start">
            <div class="error-code mb-2">404</div>
            <h1 class="display-4 fw-bold mb-3">@Localizer["NotFound_Heading"]</h1>
            <p class="lead text-muted mb-5">
                @Localizer["NotFound_Description"]
            </p>

            <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                <a asp-controller="Home" asp-action="Index" asp-route-culture="@currentCulture" class="btn btn-primary btn-rounded shadow-sm">
                    <i class="fas fa-home me-2"></i> @Localizer["BackToHome"]
                </a>
                <a asp-controller="BlogPosts" asp-action="Index" asp-route-culture="@currentCulture" class="btn btn-outline-secondary btn-rounded">
                    <i class="fas fa-blog me-2"></i> @Localizer["ViewBlog"]
                </a>
            </div>
        </div>

        <div class="col-lg-6 d-none d-lg-block">
            @* Use url absoluta para a imagem para evitar erro de path *@
            <img src="/404.svg" alt="@Localizer["NotFound_Title"]" class="error-illustration">
        </div>
    </div>
</div>

<div class="container mb-5">
    <h3 class="text-center mb-4 fw-bold">@Localizer["SuggestedPosts_Title"]</h3>
    
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col-md-4">
                    <div class="card card-error shadow-sm h-100 border-0">
                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "/uploads/blog/default-post.jpg" : post.ImageUrl)"
                             class="card-img-top rounded-top"
                             style="height: 180px; object-fit: cover;"
                             alt="@post.Title">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">@post.Title</h5>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-controller="BlogPosts" asp-action="Details"
                               asp-route-culture="@post.Culture"
                               asp-route-slug="@post.Slug"
                               class="btn btn-sm btn-link p-0 text-decoration-none fw-bold">
                                @Localizer["ReadMore"] <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>