@model MasterStack.Models.ExternalJobSource
@using MasterStack.Models
@{
    ViewData["Title"] = "Editar Fonte Externa";
    var culture = ViewBag.Culture as string ?? "fr-CA";
}

<div class="container py-4" style="max-width: 850px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-pencil-square text-primary me-2"></i>Editar Fonte: @Model.Name</h3>
        <a asp-action="Index" asp-route-culture="@culture" class="btn btn-outline-secondary">Voltar</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.LastErrorMessage))
    {
        <div class="alert alert-danger">
            <strong>Último erro registrado:</strong> @Model.LastErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ProviderType" class="form-label fw-bold"></label>
                        <select asp-for="ProviderType" asp-items="Html.GetEnumSelectList<JobSourceProviderType>()" class="form-select" id="providerSelect"></select>
                    </div>

                    <div class="col-12">
                        <label asp-for="EndpointOrSlug" class="form-label fw-bold" id="endpointLabel">Endpoint JSON ou Slug</label>
                        <input asp-for="EndpointOrSlug" class="form-control" id="endpointInput" />
                        <span asp-validation-for="EndpointOrSlug" class="text-danger d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LocationFilter" class="form-label fw-bold"></label>
                        <input asp-for="LocationFilter" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TechKeywordsFilter" class="form-label fw-bold"></label>
                        <input asp-for="TechKeywordsFilter" class="form-control" />
                    </div>
                </div>

                <div id="customJsonSection" class="mt-4 p-3 bg-light border rounded d-none">
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-braces me-1"></i> Mapeamento de Propriedades JSON</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Caminho do Array Raiz (JsonRootArrayPath)</label>
                            <input asp-for="JsonRootArrayPath" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Campo Título (MapTitleField)</label>
                            <input asp-for="MapTitleField" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Campo URL da Vaga (MapUrlField)</label>
                            <input asp-for="MapUrlField" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Campo Empresa (MapCompanyField)</label>
                            <input asp-for="MapCompanyField" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Campo Localização (MapLocationField)</label>
                            <input asp-for="MapLocationField" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Campo Descrição (MapDescriptionField)</label>
                            <input asp-for="MapDescriptionField" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                    <label class="form-check-label fw-bold" asp-for="IsActive">Fonte Ativa para Sincronização</label>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-culture="@culture" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const select = document.getElementById("providerSelect");
            const customSection = document.getElementById("customJsonSection");

            function toggleProviderFields() {
                if (select.value === "4") {
                    customSection.classList.remove("d-none");
                } else {
                    customSection.classList.add("d-none");
                }
            }

            select.addEventListener("change", toggleProviderFields);
            toggleProviderFields();
        });
    </script>
}