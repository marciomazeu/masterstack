@model MasterStack.Models.JobPosting
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["JobEdit_PageTitle"];
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<div class="container mt-4 mb-5" style="max-width: 850px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">@Localizer["JobEdit_PageTitle"]</h2>
        <a asp-action="Index" asp-route-culture="@culture" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> @Localizer["JobEdit_BackBtn"]
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post" id="jobEditForm" class="card card-body shadow-sm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RecruiterId" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">@Localizer["JobEdit_TitleLabel"]</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label fw-bold">@Localizer["JobEdit_CompanyLabel"]</label>
                <input asp-for="CompanyName" class="form-control" required />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label fw-bold">@Localizer["JobEdit_LocationLabel"]</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsRemote" class="form-check-input" type="checkbox" id="isRemoteCheck" />
            <label class="form-check-label fw-bold" for="isRemoteCheck">@Localizer["JobEdit_IsRemoteLabel"]</label>
        </div>

        <!-- EDITOR QUILL.JS -->
        <div class="mb-3">
            <label class="form-label fw-bold">@Localizer["JobEdit_DescriptionLabel"]</label>
            <div id="quill-editor" style="height: 350px; background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                @Html.Raw(Model?.Description ?? string.Empty)
            </div>
            <!-- Input oculto para submeter o HTML do Quill ao ASP.NET -->
            <input type="hidden" asp-for="Description" id="quill-content">
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-4 form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
            <label class="form-check-label fw-bold" for="isActiveCheck">@Localizer["JobEdit_IsActiveLabel"]</label>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-route-culture="@culture" class="btn btn-secondary">@Localizer["JobEdit_CancelBtn"]</a>
            <button type="submit" class="btn btn-primary fw-bold">@Localizer["JobEdit_SubmitBtn"]</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <!-- ESTILOS E SCRIPTS DO QUILL.JS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        // Inicialização do Quill
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: '@Localizer["JobEdit_QuillPlaceholder"]',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'clean']
                ]
            }
        });

        // Copia o conteúdo HTML do Quill para o input hidden antes de enviar
        document.getElementById('jobEditForm').onsubmit = function () {
            document.getElementById('quill-content').value = quill.root.innerHTML;
            return true;
        };
    </script>
}