@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model IEnumerable<MasterStack.Models.JobPosting>

@{
    ViewData["Title"] = Localizer["JobMgmt_Title_MyPublishedJobs"];
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<!-- ✅ 'w-100 mx-auto' garante centralização e limite rígido de 1200px -->
<div class="container-xl w-100 mx-auto py-4" style="max-width: 1200px !important;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">@Localizer["Recruiter_MyJobs_Title"]</h3>
            <p class="text-muted small mb-0">@Localizer["Recruiter_MyJobs_Subtitle"]</p>
        </div>
        <a asp-action="CreateJob" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> @Localizer["Recruiter_CreateJob_Btn"]
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <!-- ✅ Ajustado para chaves que batem exatamente com o .resx -->
                            <th class="ps-4 py-3">@Localizer["Job_Title"]</th>
                            <th class="py-3 text-center">@Localizer["Job_Candidates"]</th>
                            <th class="py-3" style="width: 200px;">@Localizer["Job_Status"]</th>
                            <th class="text-end pe-4 py-3" style="width: 240px;">@Localizer["Job_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-briefcase fs-1 d-block mb-2 text-secondary"></i>
                                    @Localizer["Job_NoJobsFound"]
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in Model)
                            {
                                var totalApplications = job.Applications?.Count ?? 0;
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        <div class="fw-bold text-dark">@job.Title</div>
                                        <div class="small text-muted">@job.CompanyName @(!string.IsNullOrEmpty(job.Location) ? $"• {job.Location}" : "")</div>
                                        
                                        @if (job.IsClosed && job.ClosedAt.HasValue)
                                        {
                                            <div class="small text-danger mt-1" style="font-size: 0.75rem;">
                                                <i class="bi bi-clock-history me-1"></i>
                                                @Localizer["Job_AutoDeletionIn"]: @job.ClosedAt.Value.AddDays(30).ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </td>

                                    <!-- Candidatos -->
                                    <td class="text-center">
                                        <a asp-action="Applications" asp-route-jobId="@job.Id" class="btn btn-sm btn-light border position-relative rounded-pill px-3 fw-semibold text-decoration-none">
                                            <i class="bi bi-people-fill text-primary me-1"></i>
                                            <span>@totalApplications</span> @Localizer["Job_CandidatesCount"]
                                        </a>
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (job.IsClosed)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 rounded-pill">
                                                <i class="bi bi-lock-fill me-1"></i> @Localizer["Job_StatusClosed"]
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Recruiter" asp-action="ToggleStatus" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <select name="isActive" class="form-select form-select-sm border-0 fw-semibold rounded-pill px-3 shadow-none @(job.IsActive ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")" onchange="this.form.submit()">
                                                    <option value="true" selected="@(job.IsActive ? "selected" : null)">
                                                        🟢 @Localizer["Job_StatusActive"]
                                                    </option>
                                                    <option value="false" selected="@(!job.IsActive ? "selected" : null)">
                                                        🟡 @Localizer["Job_StatusInactive"]
                                                    </option>
                                                </select>
                                            </form>
                                        }
                                    </td>

                                    <!-- Ações -->
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                                            </a>

                                            @if (!job.IsClosed)
                                            {
                                                <form id="closeJobForm-@job.Id" asp-controller="Recruiter" asp-action="CloseJob" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="confirmCloseJob(@job.Id, '@job.Title')">
                                                        <i class="bi bi-x-circle me-1"></i> @Localizer["Job_BtnClose"]
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<!-- MODAL DE CONFIRMAÇÃO -->
<div class="modal fade" id="closeJobModal" tabindex="-1" aria-labelledby="closeJobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body text-center p-4">
                <div class="mb-3 text-warning">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                </div>
                <h5 class="fw-bold mb-2" id="closeJobModalLabel">@Localizer["Job_ModalClose_Title"]</h5>
                <p class="text-muted small mb-3">
                    @Localizer["Job_ModalClose_Text"] <strong id="modalJobTitle" class="text-dark"></strong>.
                </p>
                <div class="alert alert-warning border-0 small text-start mb-4 py-2 px-3">
                    <i class="bi bi-info-circle me-1"></i>
                    @Localizer["Job_ModalClose_Warning"]
                </div>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" id="btnConfirmCloseJob" class="btn btn-danger rounded-pill px-4">@Localizer["Job_ModalClose_ConfirmBtn"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentTargetFormId = null;

        function confirmCloseJob(jobId, jobTitle) {
            currentTargetFormId = 'closeJobForm-' + jobId;
            document.getElementById('modalJobTitle').innerText = jobTitle;

            var modal = new bootstrap.Modal(document.getElementById('closeJobModal'));
            modal.show();
        }

        document.getElementById('btnConfirmCloseJob').addEventListener('click', function () {
            if (currentTargetFormId) {
                document.getElementById(currentTargetFormId).submit();
            }
        });
    </script>
}