@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using MasterStack.Models
@inject IStringLocalizer<SharedResource> Localizer

@* 1. AQUI ESTAVA O ERRO: Alterado de JobPosting para IEnumerable<JobApplication> *@
@model IEnumerable<MasterStack.Models.JobApplication>

@{
    ViewData["Title"] = Localizer["JobApps_Title_Applications"];
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
    
    // Recupera a vaga através do primeiro item da lista (caso exista)
    var firstApp = Model?.FirstOrDefault();
    var jobTitle = firstApp?.JobPosting?.Title ?? Localizer["JobApps_Title_Applications"].Value;
    var companyName = firstApp?.JobPosting?.CompanyName ?? "";
    var location = firstApp?.JobPosting?.Location;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@Localizer["JobApps_Title_Applications"]</h2>
            @if (firstApp?.JobPosting != null)
            {
                <h4 class="text-primary">@jobTitle</h4>
                <p class="text-muted mb-0">@companyName - @(string.IsNullOrEmpty(location) ? "-" : location)</p>
            }
        </div>
        <a href="/@culture/Recruiter" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["JobApps_Btn_BackToDashboard"]
        </a>
    </div>

    <!-- Mensagens de Feedback -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["JobApps_Col_Candidate"]</th>
                            <th>@Localizer["JobApps_Col_AppliedAt"]</th>
                            <th>@Localizer["JobApps_Col_Status"]</th>
                            <th>@Localizer["JobApps_Col_Resume"]</th>
                            <th>@Localizer["JobApps_Col_StatusAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var app in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@(app.Candidate?.DisplayName ?? Localizer["JobApps_Lbl_DefaultCandidateName"].Value)</strong>
                                        <br />
                                        <small class="text-muted">@(app.Candidate?.Email)</small>
                                    </td>
                                    <td>@app.AppliedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @Localizer[$"JobApps_Status_{app.Status}"]
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            @if (!string.IsNullOrEmpty(app.ResumePath))
                                            {
                                                <a href="/@culture/Recruiter/DownloadResume/@app.Id" 
                                                   target="_blank" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> @Localizer["JobApps_Btn_ViewPdf"]
                                                </a>
                                            }

                                            <a href="/@culture/Candidate/Profile/@app.CandidateId" 
                                               target="_blank" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-person-lines-fill me-1"></i> @Localizer["JobApps_Btn_ViewProfile"]
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                       <form action="/@culture/Recruiter/UpdateApplicationStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@app.Id" />
                                        
                                        <select name="status" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                            <option value="Submitted" selected="@(app.Status == MasterStack.Models.Enums.ApplicationStatus.Submitted)">
                                                @Localizer["JobApps_Option_Submitted"]
                                            </option>
                                            <option value="InReview" selected="@(app.Status == MasterStack.Models.Enums.ApplicationStatus.InReview)">
                                                @Localizer["JobApps_Option_InReview"]
                                            </option>
                                            <option value="Approved" selected="@(app.Status == MasterStack.Models.Enums.ApplicationStatus.Approved)">
                                                @Localizer["JobApps_Option_Approved"]
                                            </option>
                                            <option value="Rejected" selected="@(app.Status == MasterStack.Models.Enums.ApplicationStatus.Rejected)">
                                                @Localizer["JobApps_Option_Rejected"]
                                            </option>
                                        </select>
                                    </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    @Localizer["JobApps_Msg_NoApplications"]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>