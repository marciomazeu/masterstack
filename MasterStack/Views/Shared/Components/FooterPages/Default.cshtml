@model IEnumerable<MasterStack.Models.StaticPage>
@using Microsoft.Extensions.Localization
@using MasterStack
@inject IStringLocalizer<SharedResource> Localizer

@{
    var currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";
}

<h5 class="text-uppercase mb-4 font-weight-bold text-primary">
    @Localizer["FooterInstitutional"]
</h5>

<ul class="list-unstyled mb-0">
    @if (Model != null && Model.Any())
    {
        @foreach (var pageItem in Model)
        {
            var translation = pageItem.Translations?.FirstOrDefault(t => t.Culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase))
                           ?? pageItem.Translations?.FirstOrDefault();

            if (translation != null)
            {
                <li class="mb-2">
                    <a asp-controller="StaticPages" 
                       asp-action="Page" 
                       asp-route-culture="@currentCulture" 
                       asp-route-slug="@pageItem.Slug" 
                       class="text-white-50 text-decoration-none footer-link">
                        <i class="fas fa-chevron-right me-2 text-primary font-xs"></i>@translation.Title
                    </a>
                </li>
            }
        }
    }
    else
    {
        <li class="mb-2">
            <a asp-controller="StaticPages" asp-action="Page" asp-route-culture="@currentCulture" asp-route-slug="sobre-nos" 
               class="text-white-50 text-decoration-none footer-link">
                <i class="fas fa-chevron-right me-2 text-primary font-xs"></i>@Localizer["MenuAbout"]
            </a>
        </li>
        <li class="mb-2">
            <a asp-controller="StaticPages" asp-action="Page" asp-route-culture="@currentCulture" asp-route-slug="termos-de-uso" 
               class="text-white-50 text-decoration-none footer-link">
                <i class="fas fa-chevron-right me-2 text-primary font-xs"></i>@Localizer["FooterTerms"]
            </a>
        </li>
    }
</ul>