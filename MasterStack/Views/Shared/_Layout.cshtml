@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Diagnostics
@inject IStringLocalizer<SharedResource> Localizer
@using MasterStack.Data
@inject ApplicationDbContext _context
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // 1. Resgata a cultura de forma robusta (via Feature -> RouteData -> CultureInfo)
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCultureFeature?.RequestCulture.Culture.Name;

    if (string.IsNullOrEmpty(currentCulture))
    {
        currentCulture = ViewContext.RouteData.Values["culture"]?.ToString();
    }

    // Se ainda for nula (caso de rota 404 sem prefixo na reexecução), verifica se veio de uma URL de erro
    if (string.IsNullOrEmpty(currentCulture))
    {
        var reExecuteFeature = Context.Features.Get<IStatusCodeReExecuteFeature>();
        if (reExecuteFeature != null)
        {
            var segments = reExecuteFeature.OriginalPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length > 0 && new[] { "pt-BR", "en-US", "fr-CA" }.Contains(segments[0]))
            {
                currentCulture = segments[0];
            }
        }
    }

    // Fallback final para a thread atual
    currentCulture ??= System.Globalization.CultureInfo.CurrentCulture.Name;

    // 2. Captura dados da rota para os links do menu
    var routeData = ViewContext.RouteData.Values;
    var currentController = routeData["controller"]?.ToString();
    var currentAction = routeData["action"]?.ToString();
    var currentId = routeData["id"]?.ToString();

    // 3. Busca a lista de idiomas
    var dbLanguages = _context.Languages.ToList();

    // 4. Busca o idioma atual comparando com o currentCulture validado
    var currentLang = dbLanguages.FirstOrDefault(l => l.Culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase)) 
                      ?? dbLanguages.FirstOrDefault(); 
    
    // Captura o slug atual da rota
    var currentSlug = ViewContext.RouteData.Values["slug"]?.ToString();
}

<!DOCTYPE html>

    @* <html lang="@ViewContext.RouteData.Values["culture"]"> *@
    <html lang="@(ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @RenderSection("MetaTags", required: false)
    <title>@(ViewData["Title"] ?? "MasterStack") - MasterStack</title>

    <meta name="description" content="@(ViewData["Description"] ?? "Sua plataforma de tecnologia multilingue.")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@currentCulture.Replace("-", "_")" />
    @foreach (var lang in dbLanguages)
{
    @* Informa ao Google as versões alternativas desta mesma página *@
    <link rel="alternate" hreflang="@lang.Culture.ToLower()" 
          href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path.ToString().Replace($"/{currentCulture}", $"/{lang.Culture}")}")" />
}
@* Tag padrão caso o idioma não seja reconhecido *@
<link rel="alternate" hreflang="x-default" href="@($"{Context.Request.Scheme}://{Context.Request.Host}/pt-BR{Context.Request.Path}")" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.0.2/css/flag-icons.min.css" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    @await RenderSectionAsync("Styles", required: false)
    @RenderSection("Head", required: false)

</head>
<body class="d-flex flex-column min-vh-100">
    

