@using MasterStack
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.EntityFrameworkCore
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@using MasterStack.Data
@inject ApplicationDbContext _context

@{
    // Isso evita o erro CS1061 ao acessar propriedades dinâmicas
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;

    // Captura os dados da rota onde o usuário está agora
    var routeData = ViewContext.RouteData.Values;
    var currentController = routeData["controller"]?.ToString();
    var currentAction = routeData["action"]?.ToString();
    var currentId = routeData["id"]?.ToString();

    // Busca os idiomas ativos do banco de dados
    var dbLanguages = await _context.Languages.Where(l => l.IsActive).ToListAsync();
    
    var currentLang = _context.Languages.FirstOrDefault(l => l.Culture == currentCulture);

}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MasterStack</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.0.2/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    @RenderSection("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container px-5">
            <a class="navbar-brand fw-bold" href="/">MASTERSTACK</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">@SharedLocalizer["MenuFeatures"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="BlogPosts" asp-action="Index"
                           asp-route-culture="@System.Globalization.CultureInfo.CurrentCulture.Name">
                            @SharedLocalizer["MenuBlog"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#tutorials">@SharedLocalizer["MenuTutorials"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">@SharedLocalizer["MenuAbout"]</a>
                    </li>
                    <form class="d-flex me-3" asp-controller="BlogPosts" asp-action="Index" method="get">
                        <input type="hidden" name="culture" value="@System.Globalization.CultureInfo.CurrentCulture.Name" />
                        <div class="input-group">
                            <input type="text"
                                   name="searchTerm"
                                   class="form-control border-secondary bg-dark text-white shadow-none"
                                   placeholder="@Localizer["SearchPlaceholder"]"
                                   value="@Context.Request.Query["searchTerm"]"
                                   aria-label="Search"
                                   @* A mágica acontece aqui: *@
                                   value="@Context.Request.Query["searchTerm"]"
                                   style="max-width: 180px; border-color: rgba(255,255,255,0.2) !important;">
                            <button class="btn btn-outline-primary btn-sm" type="submit">
                                <i class="fas fa-search"></i>
                            </button
                         
                        </div>
                    </form>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown">
                            @if (currentLang != null)
                            {
                                <span class="fi @currentLang.FlagClass me-2"></span> 
                                @currentLang.Name
                            }
                            else
                            {
                                <span>Idiomas</span>
                            }
                        </a>
                        
                        <ul class="dropdown-menu">
                            @foreach (var lang in dbLanguages)
                            {
                                // ... (mantenha sua lógica de targetController e targetAction anterior)

                                if (currentController == "BlogPosts" && currentAction == "Details")
                                {
                                    var currentTrans = ViewBag.CurrentTranslation as MasterStack.Models.BlogPostTranslation;
                                    var targetSlug = currentTrans?.BlogPost?.Translations
                                    .FirstOrDefault(t => t.Culture.ToLower() == lang.Culture.ToLower())?.Slug;

                                    if (!string.IsNullOrEmpty(targetSlug))
                                    {
                                        // Se tem tradução, link normal
                                        <a class="dropdown-item" asp-controller="BlogPosts" asp-action="Details"
                                           asp-route-culture="@lang.Culture" asp-route-slug="@targetSlug">
                                            <span class="fi @lang.FlagClass me-2"></span> @lang.Name
                                        </a>
                                    }
                                    else
                                    {
                                        // Se NÃO tem tradução, manda para Index com um aviso
                                        <a class="dropdown-item" asp-controller="BlogPosts" asp-action="Index"
                                           asp-route-culture="@lang.Culture" asp-route-notfound="true">
                                            <span class="fi @lang.FlagClass me-2"></span> @lang.Name
                                        </a>
                                    }
                                }
                                else
                                {
                                    @* Link padrão para outras páginas *@
                                    <a class="dropdown-item" asp-route-culture="@lang.Culture">
                                        <span class="fi @lang.FlagClass me-2"></span> @lang.Name
                                    </a>
                                }
                            }
                        </ul>
                    </li>
                    <li class="nav-item">
                        @* <a class="nav-link" asp-controller="BlogPosts" asp-action="Admin">@SharedLocalizer["AdminBlog"]</a> *@
                        <a class="nav-link" asp-controller="Admin" 
   asp-action="Dashboard" asp-route-culture="@currentCulture">@SharedLocalizer["AdminBlog"]</a>
                    </li>
                    <li><a asp-controller="Account" 
   asp-action="Logout" 
   asp-route-culture="@ViewContext.RouteData.Values["culture"]" 
   class="btn btn-outline-danger btn-sm">
   @Localizer["Sair"]
</a></li>
                </ul>
            </div>
        </div>
    </nav>
    

    @* Removida a div container-fluid solta para evitar espaços fantasmas *@
    <main role="main" class="flex-grow-1">
        @* O container de alertas só deve ter margem se houver algo dentro *@
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container mt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
        }

        @* O conteúdo da página vem aqui *@
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-4 mt-auto">
    <footer class="bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container text-center text-md-start">
            <div class="row text-center text-md-start">

                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-primary">MasterStack</h5>
                    <p>@Localizer["HeroSubtitle"]</p>
                </div>

                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-primary">Links</h5>
                    <p><a href="#features" class="text-white text-decoration-none">@Localizer["MenuFeatures"]</a></p>
                    <p><a href="#about" class="text-white text-decoration-none">@Localizer["MenuAbout"]</a></p>
                    <p><a href="/Privacy" class="text-white text-decoration-none">@Localizer["FooterPrivacy"]</a></p>
                </div>

                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-primary">@Localizer["FooterContact"]</h5>
                    <p><i class="fas fa-home me-3"></i> São Paulo, SP, BR</p>
                    <p><i class="fas fa-envelope me-3"></i> contato@masterstack.com</p>
                </div>
            </div>

            <hr class="mb-4">

            <div class="row align-items-center">
                <div class="col-md-7 col-lg-8">
                    <p>
                        © @DateTime.Now.Year MasterStack - @Localizer["FooterCopyright"]
                    </p>
                </div>
                <div class="col-md-5 col-lg-4">
                    <div class="text-center text-md-end">
                        <ul class="list-unstyled list-inline">
                            <li class="list-inline-item">
                                    <a href="#" class="btn-floating btn-sm text-white" aria-label="Facebook" style="font-size: 23px;"><i class="fab fa-facebook"></i></a>
                            </li>
                            <li class="list-inline-item">
                                    <a href="#" class="btn-floating btn-sm text-white" aria-label="LinkedIn" style="font-size: 23px;"><i class="fab fa-linkedin"></i></a>
                            </li>
                            <li class="list-inline-item">
                                    <a href="#" class="btn-floating btn-sm text-white" aria-label="Github" style="font-size: 23px;"><i class="fab fa-github"></i></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
