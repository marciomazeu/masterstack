    <partial name="_CookieConsentPartial" />

   @if (User.Identity?.IsAuthenticated == true)
{
    <!-- Modal de Sessão Expirada (Trilingüe: PT / FR / EN) -->
    <div class="modal fade" id="inactivityModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="inactivityModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark border-0">
                    <h5 class="modal-title font-weight-bold" id="inactivityModalLabel">
                        <i class="bi bi-clock-history me-2"></i>Sessão Expirada / Session Expirée / Session Expired
                    </h5>
                </div>
                <div class="modal-body py-4 text-center fs-6">
                    <p class="mb-2">Sua sessão expirou por inatividade (15 minutos).</p>
                    <p class="mb-2 text-muted small">Votre session a expiré en raison d'une inactivité (15 minutes).</p>
                    <p class="mb-0 text-muted small">Your session has expired due to inactivity (15 minutes).</p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-primary px-4 rounded-pill" onclick="redirectToLogout()">
                        Entrar Novamente / Se reconnecter / Log In Again
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tempo limite do JS: 14 minutos e 30 segundos (870.000 ms)
            const timeoutInMs = (14 * 60 + 30) * 1000; 
            let inactivityTimer;
            let isModalShown = false;

            function resetTimer() {
                if (isModalShown) return;
                clearTimeout(inactivityTimer);
                inactivityTimer = setTimeout(showInactivityModal, timeoutInMs);
            }

            function showInactivityModal() {
                isModalShown = true;
                const modalElement = document.getElementById('inactivityModal');
                
                if (modalElement && typeof bootstrap !== 'undefined') {
                    const bsModal = new bootstrap.Modal(modalElement);
                    bsModal.show();
                } else {
                    redirectToLogout();
                }
            }

            const activityEvents = ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'];
            activityEvents.forEach(event => {
                window.addEventListener(event, resetTimer, { passive: true });
            });

            resetTimer();
        });

        function redirectToLogout() {
            const currentCulture = document.documentElement.lang || 'pt-BR';
            window.location.href = `/${currentCulture}/Account/Logout`;
        }
    </script>
}
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
