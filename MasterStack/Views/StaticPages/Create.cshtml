@model MasterStack.Models.StaticPage
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Nova Página Estática</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" id="staticPageForm">
                <div class="mb-4">
                    <label asp-for="Slug" class="form-label fw-bold">URL da Página (Slug)</label>
                    <input asp-for="Slug" class="form-control" placeholder="ex: sobre-nos" />
                    <small class="text-muted">Isso definirá o link: masterstack.com/pt-BR/<b>sobre-nos</b></small>
                </div>

                <ul class="nav nav-tabs" id="langTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pt" type="button">Português</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#en" type="button">English</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#fr" type="button">Français</button>
                    </li>
                </ul>

                <div class="tab-content border-start border-end border-bottom p-4">
                    @* Renderizamos 3 blocos, um para cada cultura *@
                    @{ string[] cultures = { "pt-BR", "en-US", "fr-CA" }; }
                    @for (int i = 0; i < cultures.Length; i++)
                    {
                        var paneId = cultures[i].Split('-')[0];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="@paneId">
                            <input type="hidden" name="translations[@i].Culture" value="@cultures[i]" />
                            
                            <div class="mb-3">
                                <label class="form-label">Título (@cultures[i])</label>
                                <input name="translations[@i].Title" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Conteúdo</label>
                                <div id="editor-@i" style="height: 300px;"></div>
                                <input type="hidden" name="translations[@i].Content" id="content-@i" />
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Salvar Página</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    

    <script>
    document.addEventListener("DOMContentLoaded", function() {
        var editors = [];
        
        // Configuração da Toolbar (O que faz o botão de imagem aparecer)
        var toolbarOptions = [
            [{ 'header': [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            [{ 'color': [] }, { 'background': [] }],
            [{ 'align': [] }],
            ['link', 'image', 'video'], // O BOTÃO DE IMAGEM ESTÁ AQUI
            ['clean']
        ];

        // Inicializar os 3 editores
        for (var i = 0; i < 3; i++) {
            var elementId = '#editor-' + i;
            if (document.querySelector(elementId)) {
                var quill = new Quill(elementId, {
                    theme: 'snow',
                    placeholder: 'Escreva o conteúdo em ' + (i==0 ? 'Português' : i==1 ? 'Inglês' : 'Francês'),
                    modules: {
                        toolbar: toolbarOptions // Ativa a barra completa
                    }
                });
                editors.push(quill);
            }
        }

        // VINCULAR AO ENVIO DO FORMULÁRIO (Apenas um evento unificado)
        var form = document.getElementById('staticPageForm');
        form.onsubmit = function() {
            for (var j = 0; j < editors.length; j++) {
                var contentInput = document.getElementById('content-' + j);
                var html = editors[j].root.innerHTML;

                // Limpa o conteúdo se estiver vazio (padrão do Quill para "vazio")
                if (html === '<p><br></p>') html = "";

                contentInput.value = html;
                console.log("Capturado Editor " + j + ":", html);
            }
            return true; // Permite o envio do form
        };
    });
</script>
}