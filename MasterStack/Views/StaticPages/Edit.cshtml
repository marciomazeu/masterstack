@model MasterStack.Models.StaticPage
@{
    var cultures = new[] { "pt-BR", "en-US", "fr-CA" };
}

<div class="container mt-4">
    <h1>Editar Página: @Model.Slug</h1>

    <form asp-controller="StaticPages" 
      asp-action="Edit" 
      asp-route-culture="@Context.GetRouteValue("culture")" 
      asp-route-id="@Model.Id" 
      method="post" 
      id="staticPageForm">
        
        <div class="mb-3">
            <label asp-for="Slug" class="form-label font-weight-bold"></label>
            <input asp-for="Slug" class="form-control" />
        </div>

        <ul class="nav nav-tabs" id="langTabs" role="tablist">
            @for (int i = 0; i < cultures.Length; i++)
            {
                <li class="nav-item">
                    <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab" 
                            data-bs-target="#tab-@i" type="button">@cultures[i]</button>
                </li>
            }
        </ul>

        <div class="tab-content border-start border-end border-bottom p-3 bg-light">
            @for (int i = 0; i < cultures.Length; i++)
            {
                var translation = Model.Translations?.FirstOrDefault(t => t.Culture == cultures[i]);
                
                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="tab-@i">
                    @* Campo oculto do ID da tradução (CRUCIAL) *@
                    <input type="hidden" name="translations[@i].Id" value="@(translation?.Id ?? 0)" />
                    <input type="hidden" name="translations[@i].Culture" value="@cultures[i]" />

                    <div class="mb-3">
                        <label class="form-label">Título (@cultures[i])</label>
                        <input name="translations[@i].Title" class="form-control" value="@translation?.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Conteúdo</label>
                        @* O Quill será injetado aqui *@
                        <div id="editor-@i" style="height: 300px; background: white;">
                            @Html.Raw(translation?.Content)
                        </div>
                        <input type="hidden" name="translations[@i].Content" id="content-@i" value="@translation?.Content" />
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
        <div class="mt-3">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-1"></i> Salvar Alterações
            </button>
            
            @* Apontamos explicitamente para a Home do site *@
            <a asp-controller="Home" 
            asp-action="Index" 
            asp-route-culture="@Context.GetRouteValue("culture")" 
            class="btn btn-secondary">
            <i class="fas fa-home me-1"></i> Voltar para o Site
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var editors = [];
            for (var i = 0; i < @cultures.Length; i++) {
                var quill = new Quill('#editor-' + i, { theme: 'snow' });
                editors.push(quill);
            }

            var form = document.getElementById('staticPageForm');
            form.onsubmit = function() {
                for (var j = 0; j < editors.length; j++) {
                    // Copia o HTML do Quill para o input hidden antes de enviar
                    var html = editors[j].root.innerHTML;
                    if (html === '<p><br></p>') html = ""; 
                    document.getElementById('content-' + j).value = html;
                }
                return true;
            };
        });
    </script>
}