@model IEnumerable<MasterStack.Models.StaticPage>
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Pages_ManageTitle"];
    var currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "pt-BR";

    var activePages = Model.Where(p => !p.IsDeleted).ToList();
    var deletedPages = Model.Where(p => p.IsDeleted).ToList();
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3"><i class="fas fa-file-alt me-2 text-primary"></i> @Localizer["Pages_ManageContent"]</h1>
        <a asp-action="Create" asp-route-culture="@currentCulture" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> @Localizer["Pages_NewPage"]
        </a>
    </div>

    <ul class="nav nav-tabs" id="pageTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button">
                @Localizer["Pages_TabActive"] <span class="badge bg-secondary ms-1">@activePages.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link text-danger" id="trash-tab" data-bs-toggle="tab" data-bs-target="#trash" type="button">
                @Localizer["Pages_TabTrash"] <span class="badge bg-danger ms-1">@deletedPages.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white shadow-sm">
        <div class="tab-pane fade show active" id="active">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@Localizer["Pages_ColSlug"]</th>
                        <th>@Localizer["Pages_ColLanguages"]</th>
                        <th class="text-end">@Localizer["Pages_ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in activePages) {
                        <tr>
                            <td><code>/@item.Slug</code></td>
                            <td>
                                @foreach(var t in item.Translations){
                                    <span class="badge border text-dark me-1">@t.Culture.ToUpper()</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="StaticPages" asp-action="Edit" asp-route-id="@item.Id" asp-route-culture="@currentCulture" class="btn btn-sm btn-light border" title="@Localizer["Pages_BtnEdit"]">
                                    <i class="fas fa-edit text-primary"></i>
                                </a>
                                
                               <form asp-controller="StaticPages" asp-action="Delete" asp-route-id="@item.Id" asp-route-culture="@currentCulture" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@Localizer["Pages_ConfirmTrash"]')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="trash">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Pages_ColPage"]</th>
                        <th>@Localizer["Pages_ColDeletedAt"]</th>
                        <th class="text-end">@Localizer["Pages_ColRecovery"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!deletedPages.Any()) {
                        <tr><td colspan="3" class="text-center py-4 text-muted">@Localizer["Pages_EmptyTrash"]</td></tr>
                    }
                    @foreach (var item in deletedPages) {
                        <tr>
                            <td><strong>@item.Translations.FirstOrDefault()?.Title</strong> <br> <small>@item.Slug</small></td>
                            <td>@item.DeletedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <form asp-controller="StaticPages" asp-action="Restore" asp-route-id="@item.Id" asp-route-culture="@currentCulture" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fas fa-undo me-1"></i> @Localizer["Pages_BtnRestore"]
                                    </button>
                                </form>

                                <form asp-controller="StaticPages" asp-action="HardDelete" asp-route-id="@item.Id" asp-route-culture="@currentCulture" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-link text-danger" onclick="return confirm('@Localizer["Pages_ConfirmHardDelete"]')">
                                        @Localizer["Pages_BtnHardDelete"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>