@model MasterStack.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Meu Perfil";
    var currentCulture = ViewData["CurrentCulture"] as string ?? "pt-BR";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LADO ESQUERDO: Cartão de Perfil -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 mb-4">
                <div class="mb-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                        @(string.IsNullOrEmpty(Model?.DisplayName) ? "U" : Model.DisplayName.Substring(0, 1).ToUpper())
                    </div>
                </div>
                <h5 class="fw-bold mb-1">@(Model?.DisplayName ?? "Usuário")</h5>
                
                <!-- Exibe selo de coordenadas ativas se tiver Latitude/Longitude -->
                @if (Model?.Latitude != null && Model?.Longitude != null)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">
                        <i class="fas fa-crosshairs me-1"></i> Localização Ativa (@Model.City)
                    </span>
                }

                <hr class="my-3">

                <div class="text-start">
                    <h6 class="fw-bold mb-2">🛡️ Segurança da Conta</h6>
                    @if (Model != null && Model.IsTwoFactorEnabled)
                    {
                        <div class="alert alert-success p-2 small mb-0 d-flex align-items-center">
                            <i class="fas fa-shield-alt me-2"></i> 2FA Ativo
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning p-2 small mb-2">
                            <i class="fas fa-exclamation-triangle me-2"></i> 2FA Desativado
                        </div>
                        <a asp-action="EnableTwoFactor" asp-controller="Account" asp-route-culture="@currentCulture" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                            Ativar Proteção de 2 Fatores
                        </a>
                    }
                </div>

                <!-- DENTRO DA COLUNA ESQUERDA (col-md-4) -->
                <div class="card border-0 shadow-sm text-center p-4 mb-4">
                    <!-- ... (foto e nome do usuário) ... -->

                    @if (Model?.Latitude != null && Model?.Longitude != null)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-3">
                            <i class="fas fa-crosshairs me-1"></i> Localização Ativa (@Model.City)
                        </span>
                    }

                    <!-- 🚀 BOTÃO/LINK PARA EMPRESAS PRÓXIMAS -->
                    <a asp-action="Enterprises" asp-controller="User" asp-route-culture="@currentCulture" class="btn btn-primary w-100 fw-bold mb-3">
                        <i class="fas fa-building me-2"></i>Ver Empresas Próximas
                    </a>

                    <hr class="my-3">

                    <!-- ... (Sua seção de 2FA / Segurança) ... -->
                </div>
            </div>
        </div>

        <!-- LADO DIREITO: Form de Perfil, Localização e Redes Sociais -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4">
                <form asp-action="UpdateProfile" asp-controller="User" asp-route-culture="@currentCulture" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="City" id="FinalCityInput" />

                    <!-- SEÇÃO 1: INFORMAÇÕES BÁSICAS -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-user text-primary me-2"></i>Informações Pessoais</h5>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label fw-bold"></label>
                        <input asp-for="DisplayName" class="form-control" placeholder="Seu nome ou apelido" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <hr class="my-4">

                    <!-- SEÇÃO 2: LOCALIZAÇÃO -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-map-marker-alt text-primary me-2"></i>Localização para Empresas Próximas</h5>
                    <p class="text-muted small mb-3">Usado para identificar empresas de tecnologia na sua região.</p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CountryCode" class="form-label fw-bold">País</label>
                            <select asp-for="CountryCode" asp-items="@(ViewBag.Countries as IEnumerable<SelectListItem>)" id="CountrySelect" class="form-select">
                                <option value="">-- Selecione o País --</option>
                            </select>
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Cidade</label>
                            <select id="CitySelect" class="form-select" disabled>
                                <option value="">-- Selecione primeiro o País --</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="CustomCityContainer">
                        <label class="form-label fw-bold text-primary">Digite o nome da sua cidade</label>
                        <input type="text" id="CustomCityInput" class="form-control" placeholder="Ex: Campinas, Laval, Québec City" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StateOrRegion" class="form-label fw-bold">Estado / Província / Região</label>
                            <input asp-for="StateOrRegion" class="form-control" placeholder="Ex: SP, QC, CA" />
                            <span asp-validation-for="StateOrRegion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label fw-bold">Código Postal / CEP / Zipcode</label>
                            <input asp-for="PostalCode" id="PostalCodeInput" class="form-control" placeholder="Ex: 13000-000, G1K 3E3, 90210" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StreetAddress" class="form-label fw-bold">Endereço (Rua / Avenida e número)</label>
                        <input asp-for="StreetAddress" class="form-control" placeholder="Ex: Av. Paulista, 1000" />
                        <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                    </div>

                    <hr class="my-4">

                    <!-- SEÇÃO 3: REDES SOCIAIS -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-share-alt text-primary me-2"></i>Redes Sociais</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="LinkedInUrl" class="form-label fw-bold"><i class="fab fa-linkedin text-primary me-1"></i> LinkedIn</label>
                            <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/seu-perfil" />
                            <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GitHubUrl" class="form-label fw-bold"><i class="fab fa-github text-dark me-1"></i> GitHub</label>
                            <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/seu-usuario" />
                            <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TwitterUrl" class="form-label fw-bold"><i class="fab fa-x-twitter me-1"></i> X / Twitter</label>
                            <input asp-for="TwitterUrl" class="form-control" placeholder="https://x.com/seu-usuario" />
                            <span asp-validation-for="TwitterUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InstagramUrl" class="form-label fw-bold"><i class="fab fa-instagram text-danger me-1"></i> Instagram</label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/seu-usuario" />
                            <span asp-validation-for="InstagramUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FacebookUrl" class="form-label fw-bold"><i class="fab fa-facebook text-primary me-1"></i> Facebook</label>
                            <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/seu-perfil" />
                            <span asp-validation-for="FacebookUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const countrySelect = document.getElementById('CountrySelect');
            const citySelect = document.getElementById('CitySelect');
            const customCityContainer = document.getElementById('CustomCityContainer');
            const customCityInput = document.getElementById('CustomCityInput');
            const finalCityInput = document.getElementById('FinalCityInput');
            
            // Lê o valor atual salvo no modelo (escapado para JS)
            const savedCity = @Html.Raw(Json.Serialize(Model?.City ?? ""));

            // Mantém o input oculto atualizado quando digita manualmente
            customCityInput.addEventListener('input', function () {
                finalCityInput.value = this.value;
            });

            // Monitora a troca de opção no dropdown de cidades
            citySelect.addEventListener('change', function () {
                if (this.value === 'OTHER') {
                    customCityContainer.classList.remove('d-none');
                    finalCityInput.value = customCityInput.value;
                } else {
                    customCityContainer.classList.add('d-none');
                    finalCityInput.value = this.value;
                }
            });

            // Função para carregar cidades via AJAX
            async function loadCities(countryCode, selectedCity = '') {
                citySelect.innerHTML = '<option value="">-- Selecione a Cidade --</option>';
                customCityContainer.classList.add('d-none');

                if (!countryCode) {
                    citySelect.disabled = true;
                    finalCityInput.value = '';
                    return;
                }

                citySelect.disabled = true;
                citySelect.innerHTML = '<option value="">Carregando cidades...</option>';

                try {
                    const baseUrl = "@Url.Action("GetCitiesByCountry", "User", new { culture = currentCulture })";
                    const response = await fetch(`${baseUrl}?countryCode=${encodeURIComponent(countryCode)}`);

                    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);

                    const cities = await response.json();
                    citySelect.innerHTML = '<option value="">-- Selecione a Cidade --</option>';

                    let cityFoundInList = false;

                    if (cities && cities.length > 0) {
                        cities.forEach(city => {
                            const option = document.createElement('option');
                            option.value = city.id;
                            option.textContent = city.name;

                            if (selectedCity && (city.id === selectedCity || city.name === selectedCity)) {
                                option.selected = true;
                                cityFoundInList = true;
                            }

                            citySelect.appendChild(option);
                        });

                        citySelect.disabled = false;

                        // Se a cidade já salva não estiver na lista pré-definida
                        if (selectedCity && !cityFoundInList) {
                            citySelect.value = 'OTHER';
                            customCityContainer.classList.remove('d-none');
                            customCityInput.value = selectedCity;
                            finalCityInput.value = selectedCity;
                        } else if (cityFoundInList) {
                            finalCityInput.value = selectedCity;
                        }
                    } else {
                        citySelect.innerHTML = '<option value="">Nenhuma cidade encontrada</option>';
                    }
                } catch (error) {
                    console.error('Erro ao buscar cidades:', error);
                    citySelect.innerHTML = '<option value="">Erro ao carregar cidades</option>';
                }
            }

            // Mudança manual no select de país pelo usuário
            countrySelect.addEventListener('change', function () {
                loadCities(this.value);
            });

            // Inicialização no carregamento da página
            if (countrySelect.value) {
                loadCities(countrySelect.value, savedCity);
            }
        });

        // Ajusta a dica/placeholder do Código Postal conforme o país escolhido
        countrySelect.addEventListener('change', function () {
            const postalInput = document.getElementById('PostalCodeInput');
            switch (this.value) {
                case 'BR':
                    postalInput.placeholder = "Ex: 13000-000";
                    break;
                case 'CA':
                    postalInput.placeholder = "Ex: G1K 3E3";
                    break;
                case 'US':
                    postalInput.placeholder = "Ex: 90210";
                    break;
                default:
                    postalInput.placeholder = "Código Postal / CEP";
                    break;
            }
        });
    </script>
}