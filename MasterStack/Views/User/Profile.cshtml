@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model MasterStack.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = Localizer["Profile_PageTitle"];
    var currentCulture = ViewData["CurrentCulture"] as string ?? "pt-BR";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LADO ESQUERDO: Cartão de Perfil -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 mb-4">
                <div class="mb-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                        @(string.IsNullOrEmpty(Model?.DisplayName) ? "U" : Model.DisplayName.Substring(0, 1).ToUpper())
                    </div>
                </div>
                <h5 class="fw-bold mb-1">@(Model?.DisplayName ?? Localizer["Profile_DefaultUser"].Value)</h5>
                
                @if (Model?.Latitude != null && Model?.Longitude != null)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">
                        <i class="fas fa-crosshairs me-1"></i> @string.Format(Localizer["Profile_LocationActive"].Value, Model.City)
                    </span>
                }

                <a href="@Url.Action("Enterprises", "Jobs", new { culture = currentCulture })" class="btn btn-primary w-100 fw-bold mb-3">
                    <i class="fas fa-building me-2"></i>@Localizer["Profile_ViewJobsAndCompaniesBtn"]
                </a>

                <hr class="my-3">

                <div class="text-start">
                    <h6 class="fw-bold mb-2">@Localizer["Profile_SecurityHeading"]</h6>
                    @if (Model != null && Model.IsTwoFactorEnabled)
                    {
                        <div class="alert alert-success p-2 small mb-0 d-flex align-items-center">
                            <i class="fas fa-shield-alt me-2"></i> @Localizer["Profile_TwoFactorActive"]
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning p-2 small mb-2">
                            <i class="fas fa-exclamation-triangle me-2"></i> @Localizer["Profile_TwoFactorDisabled"]
                        </div>
                        <a asp-action="EnableTwoFactor" asp-controller="Account" asp-route-culture="@currentCulture" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                            @Localizer["Profile_EnableTwoFactorBtn"]
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- LADO DIREITO: Form de Perfil, Localização e Redes Sociais -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4">
                <form asp-action="UpdateProfile" asp-controller="User" asp-route-culture="@currentCulture" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="City" id="FinalCityInput" />

                    <!-- SEÇÃO 1: INFORMAÇÕES BÁSICAS -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-user text-primary me-2"></i>@Localizer["Profile_PersonalInfoSection"]</h5>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label fw-bold">@Localizer["Profile_DisplayNameLabel"]</label>
                        <input asp-for="DisplayName" class="form-control" placeholder="@Localizer["Profile_DisplayNamePlaceholder"]" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <hr class="my-4">

                    <!-- SEÇÃO 2: LOCALIZAÇÃO -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-map-marker-alt text-primary me-2"></i>@Localizer["Profile_LocationSection"]</h5>
                    <p class="text-muted small mb-3">@Localizer["Profile_LocationDescription"]</p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CountryCode" class="form-label fw-bold">@Localizer["Profile_CountryLabel"]</label>
                            <select asp-for="CountryCode" asp-items="@(ViewBag.Countries as IEnumerable<SelectListItem>)" id="CountrySelect" class="form-select">
                                <option value="">@Localizer["Profile_SelectCountry"]</option>
                            </select>
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@Localizer["Profile_CityLabel"]</label>
                            <select id="CitySelect" class="form-select" disabled>
                                <option value="">@Localizer["Profile_SelectCountryFirst"]</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="CustomCityContainer">
                        <label class="form-label fw-bold text-primary">@Localizer["Profile_CustomCityLabel"]</label>
                        <input type="text" id="CustomCityInput" class="form-control" placeholder="@Localizer["Profile_CustomCityPlaceholder"]" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StateOrRegion" class="form-label fw-bold">@Localizer["Profile_StateOrRegionLabel"]</label>
                            <input asp-for="StateOrRegion" class="form-control" placeholder="@Localizer["Profile_StateOrRegionPlaceholder"]" />
                            <span asp-validation-for="StateOrRegion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label fw-bold">@Localizer["Profile_PostalCodeLabel"]</label>
                            <input asp-for="PostalCode" id="PostalCodeInput" class="form-control" placeholder="@Localizer["Profile_PostalCodePlaceholder"]" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StreetAddress" class="form-label fw-bold">@Localizer["Profile_StreetAddressLabel"]</label>
                        <input asp-for="StreetAddress" class="form-control" placeholder="@Localizer["Profile_StreetAddressPlaceholder"]" />
                        <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                    </div>

                    <hr class="my-4">

                    <!-- SEÇÃO 3: REDES SOCIAIS -->
                    <h5 class="fw-bold mb-3"><i class="fas fa-share-alt text-primary me-2"></i>@Localizer["Profile_SocialSection"]</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="LinkedInUrl" class="form-label fw-bold"><i class="fab fa-linkedin text-primary me-1"></i> LinkedIn</label>
                            <input asp-for="LinkedInUrl" class="form-control" placeholder="@Localizer["Profile_LinkedInPlaceholder"]" />
                            <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GitHubUrl" class="form-label fw-bold"><i class="fab fa-github text-dark me-1"></i> GitHub</label>
                            <input asp-for="GitHubUrl" class="form-control" placeholder="@Localizer["Profile_GitHubPlaceholder"]" />
                            <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TwitterUrl" class="form-label fw-bold"><i class="fab fa-x-twitter me-1"></i> X / Twitter</label>
                            <input asp-for="TwitterUrl" class="form-control" placeholder="@Localizer["Profile_TwitterPlaceholder"]" />
                            <span asp-validation-for="TwitterUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InstagramUrl" class="form-label fw-bold"><i class="fab fa-instagram text-danger me-1"></i> Instagram</label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="@Localizer["Profile_InstagramPlaceholder"]" />
                            <span asp-validation-for="InstagramUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FacebookUrl" class="form-label fw-bold"><i class="fab fa-facebook text-primary me-1"></i> Facebook</label>
                            <input asp-for="FacebookUrl" class="form-control" placeholder="@Localizer["Profile_FacebookPlaceholder"]" />
                            <span asp-validation-for="FacebookUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="fas fa-save me-2"></i>@Localizer["Profile_SaveBtn"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const countrySelect = document.getElementById('CountrySelect');
            const citySelect = document.getElementById('CitySelect');
            const customCityContainer = document.getElementById('CustomCityContainer');
            const customCityInput = document.getElementById('CustomCityInput');
            const finalCityInput = document.getElementById('FinalCityInput');
            
            const savedCity = @Html.Raw(Json.Serialize(Model?.City ?? ""));

            customCityInput.addEventListener('input', function () {
                finalCityInput.value = this.value;
            });

            citySelect.addEventListener('change', function () {
                if (this.value === 'OTHER') {
                    customCityContainer.classList.remove('d-none');
                    finalCityInput.value = customCityInput.value;
                } else {
                    customCityContainer.classList.add('d-none');
                    finalCityInput.value = this.value;
                }
            });

            async function loadCities(countryCode, selectedCity = '') {
                citySelect.innerHTML = '<option value="">@Localizer["Profile_SelectCity"]</option>';
                customCityContainer.classList.add('d-none');

                if (!countryCode) {
                    citySelect.disabled = true;
                    finalCityInput.value = '';
                    return;
                }

                citySelect.disabled = true;
                citySelect.innerHTML = '<option value="">@Localizer["Profile_LoadingCities"]</option>';

                try {
                    const baseUrl = "@Url.Action("GetCitiesByCountry", "User", new { culture = currentCulture })";
                    const response = await fetch(`${baseUrl}?countryCode=${encodeURIComponent(countryCode)}`);

                    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);

                    const cities = await response.json();
                    citySelect.innerHTML = '<option value="">@Localizer["Profile_SelectCity"]</option>';

                    let cityFoundInList = false;

                    if (cities && cities.length > 0) {
                        cities.forEach(city => {
                            const option = document.createElement('option');
                            option.value = city.id;
                            option.textContent = city.name;

                            if (selectedCity && (city.id === selectedCity || city.name === selectedCity)) {
                                option.selected = true;
                                cityFoundInList = true;
                            }

                            citySelect.appendChild(option);
                        });

                        citySelect.disabled = false;

                        if (selectedCity && !cityFoundInList) {
                            citySelect.value = 'OTHER';
                            customCityContainer.classList.remove('d-none');
                            customCityInput.value = selectedCity;
                            finalCityInput.value = selectedCity;
                        } else if (cityFoundInList) {
                            finalCityInput.value = selectedCity;
                        }
                    } else {
                        citySelect.innerHTML = '<option value="">@Localizer["Profile_NoCitiesFound"]</option>';
                    }
                } catch (error) {
                    console.error('Erro ao buscar cidades:', error);
                    citySelect.innerHTML = '<option value="">@Localizer["Profile_ErrorLoadingCities"]</option>';
                }
            }

            countrySelect.addEventListener('change', function () {
                loadCities(this.value);
            });

            if (countrySelect.value) {
                loadCities(countrySelect.value, savedCity);
            }

            countrySelect.addEventListener('change', function () {
                const postalInput = document.getElementById('PostalCodeInput');
                switch (this.value) {
                    case 'BR':
                        postalInput.placeholder = "Ex: 13000-000";
                        break;
                    case 'CA':
                        postalInput.placeholder = "Ex: G1K 3E3";
                        break;
                    case 'US':
                        postalInput.placeholder = "Ex: 90210";
                        break;
                    default:
                        postalInput.placeholder = "@Localizer["Profile_PostalCodePlaceholder"]";
                        break;
                }
            });
        });
    </script>
}